    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000017Quality -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000017Quality">
        <rdfs:subClassOf rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/qualityQuantifiedAs"/>
                <owl:someValuesFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Is a possessed aspect being a role of the substance of an artefact when used to construct the artefact from. Therefore the substance should be in a solid state at the conditions at which the artefact exists.</obo:IAO_0000115>
        <pav:derivedFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000017"/>
        <rdfs:label>body material</rdfs:label>
    </owl:Class>
    


