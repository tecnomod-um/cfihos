        <schema:category rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-42000173"/>
        <schema:category rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-42000201"/>
        <schema:category rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-42000228"/>
