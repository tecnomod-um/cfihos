    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000009Quality -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000009Quality">
        <rdfs:subClassOf rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/qualityQuantifiedAs"/>
