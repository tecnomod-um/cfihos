        <rdfs:subClassOf rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/Quality"/>
        <obo:IAO_0000115>Specify in which group the physical object is divided in accordance with the directive 94/9/EC.</obo:IAO_0000115>
        <pav:derivedFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000011"/>
