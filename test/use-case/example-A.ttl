                     CFIHOS:CFIHOS-40000589 :ball_valve_instance_stem_seal_design ;
                     CFIHOS:CFIHOS-40000591 :ball_valve_instance_rating .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_full_bore
:ball_valve_instance_full_bore rdf:type owl:NamedIndividual ,
                                        CFIHOS:BooleanValue ;
                               qudt:value "true"^^xsd:boolean .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_length
:ball_valve_instance_length rdf:type owl:NamedIndividual ,
                                     om-2:Measure ;
                            om-2:hasUnit CFIHOS:CFIHOS-60001446 ;
                            om-2:hasNumericalValue 15.0 .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_maximum_design_pressure
:ball_valve_instance_maximum_design_pressure rdf:type owl:NamedIndividual ,
                                                      om-2:Measure ;
                                             om-2:hasUnit CFIHOS:CFIHOS-60001431 ;
                                             om-2:hasNumericalValue 13.7 .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_operating_temeperature
:ball_valve_instance_operating_temeperature rdf:type owl:NamedIndividual ,
                                                     om-2:Measure ;
                                            om-2:hasUnit CFIHOS:CFIHOS-60001435 ;
                                            om-2:hasNumericalValue 20.0 .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_rating
:ball_valve_instance_rating rdf:type owl:NamedIndividual ,
                                     CFIHOS:TextValue ;
                            qudt:value "CL150" .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_remark_1
:ball_valve_instance_remark_1 rdf:type owl:NamedIndividual ,
                                       CFIHOS:TextValue ;
                              qudt:value """VDS maximum operating temperature does not reflect use in saliferous atmosphere.
Valves shall not be used above 60ºC in saliferous atmosphere.""" .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_remark_2
:ball_valve_instance_remark_2 rdf:type owl:NamedIndividual ,
                                       CFIHOS:TextValue ;
                              qudt:value "The soft seat on floating valves shall be secured in a pocket in the valve body." .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_remark_3
:ball_valve_instance_remark_3 rdf:type owl:NamedIndividual ,
                                       CFIHOS:TextValue ;
                              qudt:value "Wetted parts suitable for sour service to NACE MR0175 / ISO 15156-3." .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_special_design_req
:ball_valve_instance_special_design_req rdf:type owl:NamedIndividual ,
                                                 CFIHOS:TextValue ;
                                        qudt:value "QSL/CAS level specified in General VSK" .
 
 
###  http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_stem_seal_design
:ball_valve_instance_stem_seal_design rdf:type owl:NamedIndividual ,
                                               CFIHOS:TextValue ;
                                      qudt:value "O-ring" .
 
 
