    <!-- http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_remark_1 -->

    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS-example-A#ball_valve_instance_remark_1">
