# Reverse-direction interoperability test #2: CFIHOS-IDO terms (qualities
# included) reconstructed FROM valve-instances-ido-only.ttl. Companion to
# valve-instances-cfihos-from-ido.ttl, which collapsed straight to direct
# CFIHOS property assertions (no Quality individuals). This file instead
# reconstructs the MIXED CFIHOS-IDO style - the same style as
# valve-instances-ido-aligned.ttl (CFIHOS-badged Quality classes connected
# via ido:hasQuality / ido:qualityQuantifiedAs) - but built by going the
# other way around the loop:
#
#   valve-instances-compliant.ttl (CFIHOS-native)
#         --(CFIHOS -> IDO)-->        valve-instances-ido-aligned.ttl   [existing, forward]
#         --(strip CFIHOS)-->         valve-instances-ido-only.ttl      [existing, pure IDO]
#         --(IDO labels -> CFIHOS-IDO, qualities kept)--> this file      [new, reverse]
#
# valve-instances-ido-aligned.ttl and this file describe the same 10 valves
# and should be structurally identical (same Quality classes, same datum
# values) even though one was derived forward from CFIHOS and the other
# backward from pure-IDO labels - that agreement is itself the
# interoperability test.
#
# RECONSTRUCTION METHOD: each ido-only quality's rdfs:label was matched
# against the verified label<->CFIHOS-code table (from CORE-CFIHOS-V2.0_ido.owl,
# same table used for valve-instances-cfihos-from-ido.ttl), then re-typed as
# the corresponding CFIHOS-badged Quality class instead of collapsing to a
# bare property assertion:
#
#   "body material"          -> CFIHOS-40000017Quality
#   "inlet connection type"  -> CFIHOS-40000586Quality
#   "outlet connection type" -> CFIHOS-40000587Quality
#   "seat design type"       -> CFIHOS-40000588Quality
#   "stem sealing type"      -> CFIHOS-40000589Quality
#   "valve operator type"    -> CFIHOS-40000590Quality
#   "pressure rating"        -> CFIHOS-40000591Quality
#   "seat leakage class"     -> CFIHOS-40000592Quality
#   "temperature rating"     -> CFIHOS-40000593Quality
#
# Asset typing: rdfs:label "gate valve" on ido:PhysicalArtefact matched back
# to cfihos-eq:CFIHOS-30000838 (unambiguous - it is the only CFIHOS equipment
# class with that label).
#
# WHAT STILL DOESN'T SURVIVE (same as the other reverse file, for the same
# reason): CFIHOS:hasTag / tag individuals and CFIHOS-40000570 (manufacturer
# name) - neither reached valve-instances-ido-only.ttl in the forward
# direction, so there is nothing here to reconstruct them from. Quality
# individual local names are freshly assigned per valve (ValveNNN_XQ,
# matching each valve's own identifier) rather than reused from the ido-only
# file, since that file's names are decoupled from their subject valve for
# Valve101 specifically (an intentional edit noted in that file).

@prefix CFIHOS:    <http://infohub.siemens-energy.com/CFIHOS#> .
@prefix cfihos-eq: <http://infohub.siemens-energy.com/CFIHOS/equipment#> .
@prefix ido:       <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix ex:        <http://example.org/cfhios#> .

# ---- shared controlled-vocabulary value individuals (identical IRIs/typing
#      to valve-instances-ido-aligned.ttl / valve-instances-cfihos-from-ido.ttl) ----

ex:Material_SS316        a CFIHOS:CFIHOS-50000070 .
ex:Material_CarbonSteel  a CFIHOS:CFIHOS-50000070 .
ex:Material_DuplexSS     a CFIHOS:CFIHOS-50000070 .

ex:Conn_Flanged150       a CFIHOS:CFIHOS-50000127 .
ex:Conn_Flanged300       a CFIHOS:CFIHOS-50000127 .
ex:Conn_Threaded         a CFIHOS:CFIHOS-50000127 .
ex:Conn_ButtWeld         a CFIHOS:CFIHOS-50000127 .

ex:SeatDesign_Soft       a CFIHOS:CFIHOS-50000126 .
ex:SeatDesign_Metal      a CFIHOS:CFIHOS-50000126 .

ex:StemSeal_Bellows      a CFIHOS:TextValue .
ex:StemSeal_PTFEPacking  a CFIHOS:TextValue .

ex:Operator_Manual       a CFIHOS:TextValue .
ex:Operator_Gearbox      a CFIHOS:TextValue .
ex:Operator_Pneumatic    a CFIHOS:TextValue .

ex:PressureRating_150    a CFIHOS:TextValue .
ex:PressureRating_300    a CFIHOS:TextValue .
ex:PressureRating_600    a CFIHOS:TextValue .

ex:SeatLeakage_ClassIV   a CFIHOS:CFIHOS-50000125 .
ex:SeatLeakage_ClassVI   a CFIHOS:CFIHOS-50000125 .

ex:TempRating_Minus29to400 a CFIHOS:TextValue .
ex:TempRating_Minus46to200 a CFIHOS:TextValue .

# ---- 10 valve instances, CFIHOS-IDO mixed vocabulary, qualities included ----
# (ex:Valve101 keeps the identifier currently used for the first valve in
# valve-instances-ido-only.ttl / valve-instances-ido-aligned.ttl.)

ex:Valve101
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve101_BodyMaterialQ, ex:Valve101_InletConnQ, ex:Valve101_OutletConnQ,
                   ex:Valve101_SeatDesignQ, ex:Valve101_StemSealQ, ex:Valve101_OperatorTypeQ,
                   ex:Valve101_PressureRatingQ, ex:Valve101_SeatLeakageQ, ex:Valve101_TempRatingQ .

ex:Valve101_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_SS316 .
ex:Valve101_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve101_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve101_SeatDesignQ     a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve101_StemSealQ       a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve101_OperatorTypeQ   a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Manual .
ex:Valve101_PressureRatingQ a CFIHOS:CFIHOS-40000591Quality ; ido:qualityQuantifiedAs ex:PressureRating_150 .
ex:Valve101_SeatLeakageQ    a CFIHOS:CFIHOS-40000592Quality ; ido:qualityQuantifiedAs ex:SeatLeakage_ClassVI .
ex:Valve101_TempRatingQ     a CFIHOS:CFIHOS-40000593Quality ; ido:qualityQuantifiedAs ex:TempRating_Minus29to400 .

ex:Valve002
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve002_BodyMaterialQ, ex:Valve002_InletConnQ, ex:Valve002_OutletConnQ,
                   ex:Valve002_SeatDesignQ, ex:Valve002_StemSealQ, ex:Valve002_OperatorTypeQ,
                   ex:Valve002_PressureRatingQ, ex:Valve002_SeatLeakageQ, ex:Valve002_TempRatingQ .

ex:Valve002_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_CarbonSteel .
ex:Valve002_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve002_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve002_SeatDesignQ     a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve002_StemSealQ       a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_PTFEPacking .
ex:Valve002_OperatorTypeQ   a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Gearbox .
ex:Valve002_PressureRatingQ a CFIHOS:CFIHOS-40000591Quality ; ido:qualityQuantifiedAs ex:PressureRating_300 .
ex:Valve002_SeatLeakageQ    a CFIHOS:CFIHOS-40000592Quality ; ido:qualityQuantifiedAs ex:SeatLeakage_ClassIV .
ex:Valve002_TempRatingQ     a CFIHOS:CFIHOS-40000593Quality ; ido:qualityQuantifiedAs ex:TempRating_Minus46to200 .

ex:Valve003
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve003_BodyMaterialQ, ex:Valve003_InletConnQ, ex:Valve003_OutletConnQ,
                   ex:Valve003_SeatDesignQ, ex:Valve003_OperatorTypeQ, ex:Valve003_SeatLeakageQ .

ex:Valve003_BodyMaterialQ a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_DuplexSS .
ex:Valve003_InletConnQ    a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve003_OutletConnQ   a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve003_SeatDesignQ   a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve003_OperatorTypeQ a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Pneumatic .
ex:Valve003_SeatLeakageQ  a CFIHOS:CFIHOS-40000592Quality ; ido:qualityQuantifiedAs ex:SeatLeakage_ClassVI .

ex:Valve004
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve004_BodyMaterialQ .

ex:Valve004_BodyMaterialQ a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_SS316 .

ex:Valve005
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve005_BodyMaterialQ, ex:Valve005_InletConnQ, ex:Valve005_OutletConnQ,
                   ex:Valve005_SeatDesignQ, ex:Valve005_StemSealQ, ex:Valve005_OperatorTypeQ,
                   ex:Valve005_PressureRatingQ, ex:Valve005_SeatLeakageQ, ex:Valve005_TempRatingQ .

ex:Valve005_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_CarbonSteel .
ex:Valve005_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_Threaded .
ex:Valve005_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_Threaded .
ex:Valve005_SeatDesignQ     a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve005_StemSealQ       a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve005_OperatorTypeQ   a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Manual .
ex:Valve005_PressureRatingQ a CFIHOS:CFIHOS-40000591Quality ; ido:qualityQuantifiedAs ex:PressureRating_150 .
ex:Valve005_SeatLeakageQ    a CFIHOS:CFIHOS-40000592Quality ; ido:qualityQuantifiedAs ex:SeatLeakage_ClassIV .
ex:Valve005_TempRatingQ     a CFIHOS:CFIHOS-40000593Quality ; ido:qualityQuantifiedAs ex:TempRating_Minus29to400 .

ex:Valve006
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve006_BodyMaterialQ, ex:Valve006_InletConnQ, ex:Valve006_OutletConnQ,
                   ex:Valve006_PressureRatingQ, ex:Valve006_TempRatingQ .

ex:Valve006_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_SS316 .
ex:Valve006_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve006_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve006_PressureRatingQ a CFIHOS:CFIHOS-40000591Quality ; ido:qualityQuantifiedAs ex:PressureRating_150 .
ex:Valve006_TempRatingQ     a CFIHOS:CFIHOS-40000593Quality ; ido:qualityQuantifiedAs ex:TempRating_Minus46to200 .

ex:Valve007
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve007_BodyMaterialQ, ex:Valve007_InletConnQ, ex:Valve007_OutletConnQ,
                   ex:Valve007_SeatDesignQ, ex:Valve007_StemSealQ, ex:Valve007_OperatorTypeQ,
                   ex:Valve007_PressureRatingQ, ex:Valve007_SeatLeakageQ, ex:Valve007_TempRatingQ .

ex:Valve007_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_DuplexSS .
ex:Valve007_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve007_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve007_SeatDesignQ     a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve007_StemSealQ       a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_PTFEPacking .
ex:Valve007_OperatorTypeQ   a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Gearbox .
ex:Valve007_PressureRatingQ a CFIHOS:CFIHOS-40000591Quality ; ido:qualityQuantifiedAs ex:PressureRating_300 .
ex:Valve007_SeatLeakageQ    a CFIHOS:CFIHOS-40000592Quality ; ido:qualityQuantifiedAs ex:SeatLeakage_ClassVI .
ex:Valve007_TempRatingQ     a CFIHOS:CFIHOS-40000593Quality ; ido:qualityQuantifiedAs ex:TempRating_Minus29to400 .

ex:Valve008
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve008_BodyMaterialQ, ex:Valve008_SeatDesignQ, ex:Valve008_StemSealQ,
                   ex:Valve008_OperatorTypeQ .

ex:Valve008_BodyMaterialQ a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_CarbonSteel .
ex:Valve008_SeatDesignQ   a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve008_StemSealQ     a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve008_OperatorTypeQ a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Manual .

ex:Valve009
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve009_BodyMaterialQ, ex:Valve009_InletConnQ, ex:Valve009_OutletConnQ,
                   ex:Valve009_SeatDesignQ, ex:Valve009_StemSealQ, ex:Valve009_OperatorTypeQ,
                   ex:Valve009_PressureRatingQ, ex:Valve009_SeatLeakageQ, ex:Valve009_TempRatingQ .

ex:Valve009_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_SS316 .
ex:Valve009_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve009_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve009_SeatDesignQ     a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve009_StemSealQ       a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve009_OperatorTypeQ   a CFIHOS:CFIHOS-40000590Quality ; ido:qualityQuantifiedAs ex:Operator_Pneumatic .
ex:Valve009_PressureRatingQ a CFIHOS:CFIHOS-40000591Quality ; ido:qualityQuantifiedAs ex:PressureRating_600 .
ex:Valve009_SeatLeakageQ    a CFIHOS:CFIHOS-40000592Quality ; ido:qualityQuantifiedAs ex:SeatLeakage_ClassIV .
ex:Valve009_TempRatingQ     a CFIHOS:CFIHOS-40000593Quality ; ido:qualityQuantifiedAs ex:TempRating_Minus46to200 .

ex:Valve010
    a cfihos-eq:CFIHOS-30000838 ;
    ido:hasQuality ex:Valve010_BodyMaterialQ, ex:Valve010_InletConnQ, ex:Valve010_OutletConnQ,
                   ex:Valve010_SeatDesignQ, ex:Valve010_StemSealQ, ex:Valve010_OperatorTypeQ,
                   ex:Valve010_PressureRatingQ, ex:Valve010_SeatLeakageQ, ex:Valve010_TempRatingQ .

ex:Valve010_BodyMaterialQ   a CFIHOS:CFIHOS-40000017Quality ; ido:qualityQuantifiedAs ex:Material_DuplexSS .
ex:Valve010_InletConnQ      a CFIHOS:CFIHOS-40000586Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve010_OutletConnQ     a CFIHOS:CFIHOS-40000587Quality ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve010_SeatDesignQ     a CFIHOS:CFIHOS-40000588Quality ; ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve010_StemSealQ       a CFIHOS:CFIHOS-40000589Quality ; ido:qualityQuantifiedAs ex:StemSeal_PTFEPacking .
