    ido:hasQuality ex:Valve009_BodyMaterialQ, ex:Valve009_InletConnQ, ex:Valve009_OutletConnQ,
                   ex:Valve009_SeatDesignQ, ex:Valve009_StemSealQ, ex:Valve009_OperatorTypeQ,
