ex:Valve005_InletConnQ      a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_Threaded .
ex:Valve005_OutletConnQ     a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_Threaded .
ex:Valve005_SeatDesignQ     a ido:Quality ; rdfs:label "seat design type" ;       ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve005_StemSealQ       a ido:Quality ; rdfs:label "stem sealing type" ;      ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve005_OperatorTypeQ   a ido:Quality ; rdfs:label "valve operator type" ;    ido:qualityQuantifiedAs ex:Operator_Manual .
ex:Valve005_PressureRatingQ a ido:Quality ; rdfs:label "pressure rating" ;        ido:qualityQuantifiedAs ex:PressureRating_150 .
ex:Valve005_SeatLeakageQ    a ido:Quality ; rdfs:label "seat leakage class" ;     ido:qualityQuantifiedAs ex:SeatLeakage_ClassIV .
ex:Valve005_TempRatingQ     a ido:Quality ; rdfs:label "temperature rating" ;     ido:qualityQuantifiedAs ex:TempRating_Minus29to400 .

ex:Valve006 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve006_BodyMaterialQ, ex:Valve006_InletConnQ, ex:Valve006_OutletConnQ,
                   ex:Valve006_PressureRatingQ, ex:Valve006_TempRatingQ .
ex:Valve006_BodyMaterialQ   a ido:Quality ; rdfs:label "body material" ;          ido:qualityQuantifiedAs ex:Material_SS316 .
ex:Valve006_InletConnQ      a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve006_OutletConnQ     a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve006_PressureRatingQ a ido:Quality ; rdfs:label "pressure rating" ;        ido:qualityQuantifiedAs ex:PressureRating_150 .
ex:Valve006_TempRatingQ     a ido:Quality ; rdfs:label "temperature rating" ;     ido:qualityQuantifiedAs ex:TempRating_Minus46to200 .

