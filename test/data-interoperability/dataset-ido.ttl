    ido:hasQuality ex:Valve007_BodyMaterialQ, ex:Valve007_InletConnQ, ex:Valve007_OutletConnQ,
                   ex:Valve007_SeatDesignQ, ex:Valve007_StemSealQ, ex:Valve007_OperatorTypeQ,
                   ex:Valve007_PressureRatingQ, ex:Valve007_SeatLeakageQ, ex:Valve007_TempRatingQ .
ex:Valve007_BodyMaterialQ   a ido:Quality ; rdfs:label "body material" ;          ido:qualityQuantifiedAs ex:Material_DuplexSS .
ex:Valve007_InletConnQ      a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve007_OutletConnQ     a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve007_SeatDesignQ     a ido:Quality ; rdfs:label "seat design type" ;       ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve007_StemSealQ       a ido:Quality ; rdfs:label "stem sealing type" ;      ido:qualityQuantifiedAs ex:StemSeal_PTFEPacking .
ex:Valve007_OperatorTypeQ   a ido:Quality ; rdfs:label "valve operator type" ;    ido:qualityQuantifiedAs ex:Operator_Gearbox .
ex:Valve007_PressureRatingQ a ido:Quality ; rdfs:label "pressure rating" ;        ido:qualityQuantifiedAs ex:PressureRating_300 .
ex:Valve007_SeatLeakageQ    a ido:Quality ; rdfs:label "seat leakage class" ;     ido:qualityQuantifiedAs ex:SeatLeakage_ClassVI .
ex:Valve007_TempRatingQ     a ido:Quality ; rdfs:label "temperature rating" ;     ido:qualityQuantifiedAs ex:TempRating_Minus29to400 .

ex:Valve008 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve008_BodyMaterialQ, ex:Valve008_SeatDesignQ, ex:Valve008_StemSealQ,
                   ex:Valve008_OperatorTypeQ .
ex:Valve008_BodyMaterialQ a ido:Quality ; rdfs:label "body material" ;       ido:qualityQuantifiedAs ex:Material_CarbonSteel .
ex:Valve008_SeatDesignQ   a ido:Quality ; rdfs:label "seat design type" ;    ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve008_StemSealQ     a ido:Quality ; rdfs:label "stem sealing type" ;   ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve008_OperatorTypeQ a ido:Quality ; rdfs:label "valve operator type" ; ido:qualityQuantifiedAs ex:Operator_Manual .

