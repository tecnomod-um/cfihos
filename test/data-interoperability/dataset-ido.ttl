# Pure-IDO version of the 10 gate valve instances (no CFIHOS namespace terms
# at all - not even for typing). Companion to valve-instances-ido-aligned.ttl,
# which kept CFIHOS-badged Quality subclasses (e.g. CFIHOS-40000017Quality)
# for traceability; this file strips those out entirely, per your request.
#
# What had to change to reach "zero CFIHOS vocabulary":
#
# - Asset typing: cfihos-eq:CFIHOS-30000838 (gate valve) -> ido:PhysicalArtefact,
#   ido:InanimatePhysicalObject (the verified mapping for the CFIHOS "Equipment"
#   root, confirmed in CORE-CFIHOS-V2.0_ido.owl). The "gate valve" specificity
#   is lost as a class - IDO has no notion of valves - so it is preserved only
#   as an rdfs:label (plain RDFS annotation, not domain vocabulary).
#
# - Quality typing: each ex:ValveNNN_XQ individual is now typed directly as
#   ido:Quality (generic - IDO has no "body material quality" class of its
#   own), instead of the CFIHOS-specific CFIHOS-40000017Quality etc. Which
#   quality it is survives only via rdfs:label, copied from the label already
#   present on the corresponding CFIHOS Quality class in the bridge ontology.
#
# - Value/datum typing: the picklist value individuals (previously typed
#   CFIHOS-50000070, CFIHOS-50000127, CFIHOS:TextValue, etc.) are now typed
#   ido:QualityDatum, the generic IDO class for a quality's realized value
#   (confirmed present in CORE-CFIHOS-V2.0_ido.owl, parallel to how
#   ido:ScalarQuantityDatum is used for numeric measures). The concrete value
#   (e.g. "SS316") survives only via rdfs:label.
#
# - hasTag / tag individuals: DROPPED. CFIHOS:hasTag is a CFIHOS-specific
#   object property with no IDO equivalent asserted anywhere in
#   CORE-CFIHOS-V2.0_ido.owl. The file does declare tag:CFIHOS-30000311
#   (Tag root) as rdfs:subClassOf ido:FunctionalObject, and hasContentPart is
#   declared as an IDO object property, but hasContentPart is never actually
#   used anywhere in the bridge file (0 real axioms, only the declaration),
#   so I did not want to guess it's the right relation and assert something
#   unverified. If you can confirm the intended IDO relation linking an asset
#   to its functional identifier, I'll add the tag back in cleanly.
#
# Net effect: this file is now consumable by an agent that has never heard of
# CFIHOS and loads only the IDO core ontology - every class and property used
# below (ido:PhysicalArtefact, ido:InanimatePhysicalObject, ido:Quality,
# ido:QualityDatum, ido:hasQuality, ido:qualityQuantifiedAs) is native IDO
# vocabulary. rdfs:label/rdf:type/owl are foundational RDF/RDFS/OWL scaffolding,
# not domain vocabulary, so they are used freely on both sides.

@prefix ido:  <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix ex:   <http://example.org/ido#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# ---- shared quality-datum individuals (values), typed only as ido:QualityDatum ----

ex:Material_SS316        a ido:QualityDatum ; rdfs:label "SS316 (austenitic stainless steel)" .
ex:Material_CarbonSteel  a ido:QualityDatum ; rdfs:label "carbon steel" .
ex:Material_DuplexSS     a ido:QualityDatum ; rdfs:label "duplex stainless steel" .

ex:Conn_Flanged150       a ido:QualityDatum ; rdfs:label "flanged, Class 150" .
ex:Conn_Flanged300       a ido:QualityDatum ; rdfs:label "flanged, Class 300" .
ex:Conn_Threaded         a ido:QualityDatum ; rdfs:label "threaded" .
ex:Conn_ButtWeld         a ido:QualityDatum ; rdfs:label "butt-weld" .

ex:SeatDesign_Soft       a ido:QualityDatum ; rdfs:label "soft-seated" .
ex:SeatDesign_Metal      a ido:QualityDatum ; rdfs:label "metal-to-metal seated" .

ex:StemSeal_Bellows      a ido:QualityDatum ; rdfs:label "bellows" .
ex:StemSeal_PTFEPacking  a ido:QualityDatum ; rdfs:label "PTFE packing" .

ex:Operator_Manual       a ido:QualityDatum ; rdfs:label "manual (hand wheel)" .
ex:Operator_Gearbox      a ido:QualityDatum ; rdfs:label "gearbox operated" .
ex:Operator_Pneumatic    a ido:QualityDatum ; rdfs:label "pneumatic actuator" .

ex:PressureRating_150    a ido:QualityDatum ; rdfs:label "Class 150" .
ex:PressureRating_300    a ido:QualityDatum ; rdfs:label "Class 300" .
ex:PressureRating_600    a ido:QualityDatum ; rdfs:label "Class 600" .

ex:SeatLeakage_ClassIV   a ido:QualityDatum ; rdfs:label "seat leakage Class IV" .
ex:SeatLeakage_ClassVI   a ido:QualityDatum ; rdfs:label "seat leakage Class VI" .

ex:TempRating_Minus29to400 a ido:QualityDatum ; rdfs:label "-29 C to 400 C" .
ex:TempRating_Minus46to200 a ido:QualityDatum ; rdfs:label "-46 C to 200 C" .

# ---- 10 valve instances, pure IDO vocabulary ----

ex:Valve001 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve001_BodyMaterialQ, ex:Valve001_InletConnQ, ex:Valve001_OutletConnQ,
                   ex:Valve001_SeatDesignQ, ex:Valve001_StemSealQ, ex:Valve001_OperatorTypeQ,
                   ex:Valve001_PressureRatingQ, ex:Valve001_SeatLeakageQ, ex:Valve001_TempRatingQ .
ex:Valve001_BodyMaterialQ   a ido:Quality ; rdfs:label "body material" ;          ido:qualityQuantifiedAs ex:Material_SS316 .
ex:Valve001_InletConnQ      a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve001_OutletConnQ     a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_Flanged150 .
ex:Valve001_SeatDesignQ     a ido:Quality ; rdfs:label "seat design type" ;       ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve001_StemSealQ       a ido:Quality ; rdfs:label "stem sealing type" ;      ido:qualityQuantifiedAs ex:StemSeal_Bellows .
ex:Valve001_OperatorTypeQ   a ido:Quality ; rdfs:label "valve operator type" ;    ido:qualityQuantifiedAs ex:Operator_Manual .
ex:Valve001_PressureRatingQ a ido:Quality ; rdfs:label "pressure rating" ;        ido:qualityQuantifiedAs ex:PressureRating_150 .
ex:Valve001_SeatLeakageQ    a ido:Quality ; rdfs:label "seat leakage class" ;     ido:qualityQuantifiedAs ex:SeatLeakage_ClassVI .
ex:Valve001_TempRatingQ     a ido:Quality ; rdfs:label "temperature rating" ;     ido:qualityQuantifiedAs ex:TempRating_Minus29to400 .

ex:Valve002 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve002_BodyMaterialQ, ex:Valve002_InletConnQ, ex:Valve002_OutletConnQ,
                   ex:Valve002_SeatDesignQ, ex:Valve002_StemSealQ, ex:Valve002_OperatorTypeQ,
                   ex:Valve002_PressureRatingQ, ex:Valve002_SeatLeakageQ, ex:Valve002_TempRatingQ .
ex:Valve002_BodyMaterialQ   a ido:Quality ; rdfs:label "body material" ;          ido:qualityQuantifiedAs ex:Material_CarbonSteel .
ex:Valve002_InletConnQ      a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve002_OutletConnQ     a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_Flanged300 .
ex:Valve002_SeatDesignQ     a ido:Quality ; rdfs:label "seat design type" ;       ido:qualityQuantifiedAs ex:SeatDesign_Metal .
ex:Valve002_StemSealQ       a ido:Quality ; rdfs:label "stem sealing type" ;      ido:qualityQuantifiedAs ex:StemSeal_PTFEPacking .
ex:Valve002_OperatorTypeQ   a ido:Quality ; rdfs:label "valve operator type" ;    ido:qualityQuantifiedAs ex:Operator_Gearbox .
ex:Valve002_PressureRatingQ a ido:Quality ; rdfs:label "pressure rating" ;        ido:qualityQuantifiedAs ex:PressureRating_300 .
ex:Valve002_SeatLeakageQ    a ido:Quality ; rdfs:label "seat leakage class" ;     ido:qualityQuantifiedAs ex:SeatLeakage_ClassIV .
ex:Valve002_TempRatingQ     a ido:Quality ; rdfs:label "temperature rating" ;     ido:qualityQuantifiedAs ex:TempRating_Minus46to200 .

ex:Valve003 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve003_BodyMaterialQ, ex:Valve003_InletConnQ, ex:Valve003_OutletConnQ,
                   ex:Valve003_SeatDesignQ, ex:Valve003_OperatorTypeQ, ex:Valve003_SeatLeakageQ .
ex:Valve003_BodyMaterialQ a ido:Quality ; rdfs:label "body material" ;          ido:qualityQuantifiedAs ex:Material_DuplexSS .
ex:Valve003_InletConnQ    a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve003_OutletConnQ   a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve003_SeatDesignQ   a ido:Quality ; rdfs:label "seat design type" ;       ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve003_OperatorTypeQ a ido:Quality ; rdfs:label "valve operator type" ;    ido:qualityQuantifiedAs ex:Operator_Pneumatic .
ex:Valve003_SeatLeakageQ  a ido:Quality ; rdfs:label "seat leakage class" ;     ido:qualityQuantifiedAs ex:SeatLeakage_ClassVI .

ex:Valve004 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve004_BodyMaterialQ .
ex:Valve004_BodyMaterialQ a ido:Quality ; rdfs:label "body material" ; ido:qualityQuantifiedAs ex:Material_SS316 .

ex:Valve005 a ido:PhysicalArtefact, ido:InanimatePhysicalObject ; rdfs:label "gate valve" ;
    ido:hasQuality ex:Valve005_BodyMaterialQ, ex:Valve005_InletConnQ, ex:Valve005_OutletConnQ,
                   ex:Valve005_SeatDesignQ, ex:Valve005_StemSealQ, ex:Valve005_OperatorTypeQ,
