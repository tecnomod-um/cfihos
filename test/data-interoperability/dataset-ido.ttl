ex:Valve009_InletConnQ      a ido:Quality ; rdfs:label "inlet connection type" ;  ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve009_OutletConnQ     a ido:Quality ; rdfs:label "outlet connection type" ; ido:qualityQuantifiedAs ex:Conn_ButtWeld .
ex:Valve009_SeatDesignQ     a ido:Quality ; rdfs:label "seat design type" ;       ido:qualityQuantifiedAs ex:SeatDesign_Soft .
ex:Valve009_StemSealQ       a ido:Quality ; rdfs:label "stem sealing type" ;      ido:qualityQuantifiedAs ex:StemSeal_Bellows .
