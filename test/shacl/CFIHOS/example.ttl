###  http://infohub.siemens-energy.com/CFIHOS-IDO-example#2384
ex: rdf:type owl:NamedIndividual ,
             <http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000521> ;
    cfihos:CFIHOS-40000512 ex: ;
    lis:hasPhysicalQuantity ex: .


###  http://infohub.siemens-energy.com/CFIHOS-IDO-example#7533
ex: rdf:type owl:NamedIndividual ,
             lis:QualityDatum ;
    lis:datumUOM cfihos:CFIHOS-65001148 ;
    lis:datumValue 3.7 .


###  http://infohub.siemens-energy.com/CFIHOS-IDO-example#8453
ex: rdf:type owl:NamedIndividual ,
             cfihos:CFIHOS-40000512Quality ;
    lis:qualityQuantifiedAs ex: .


