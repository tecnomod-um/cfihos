        <schema:identifier>2309</schema:identifier>
        <rdfs:label>cathodic protection diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000042 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000042">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000042</hasCFIHOSCode>
        <obo:IAO_0000115>A procedure describing how changes through &apos;design&apos;, &apos;construction&apos; and &apos;commissioning&apos; will be managed.</obo:IAO_0000115>
        <schema:identifier>6006</schema:identifier>
        <rdfs:label>change control procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000043 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000043">
