        <hasCFIHOSCode>CFIHOS-70000368</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting  assumptions and method determining computer analysis to verify the module design for setdown condition.</obo:IAO_0000115>
        <schema:identifier>0522</schema:identifier>
        <rdfs:label>setdown analysis</rdfs:label>
    </owl:Class>
    


