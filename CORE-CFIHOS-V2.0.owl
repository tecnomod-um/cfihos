        <schema:identifier>8502</schema:identifier>
        <rdfs:label>clarification request</rdfs:label>
        <skos:altLabel>request for information (rfi)</skos:altLabel>
        <skos:altLabel>technical query (tq)</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000048 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000048">
