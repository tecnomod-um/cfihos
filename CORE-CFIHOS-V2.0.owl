        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000883</hasCFIHOSCode>
        <obo:IAO_0000115>A pipe coil in which heat is transferred from the material or space cooled to the primary refrigerant.</obo:IAO_0000115>
        <rdfs:label>cooling coil</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000885 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000885">
