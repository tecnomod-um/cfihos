            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000504</hasCFIHOSCode>
        <obo:IAO_0000115>A physical object which is a short section of pipe used to connect ends of pipes/pipelines.</obo:IAO_0000115>
        <rdfs:label>spool piece</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000505 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000505">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000230"/>
        <hasCFIHOSCode>CFIHOS-30000505</hasCFIHOSCode>
        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A trap that consists of a chamber into which condensed steam from steam pipes etc. is allowed to drain, and which automatically ejects it without permitting the escape of steam.</obo:IAO_0000115>
        <rdfs:label>steam trap</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000506 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000506">
