            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000887</hasCFIHOSCode>
        <obo:IAO_0000115>A drain port is a collection port that can be installed in pressure sensing lines for transmitters, steam lines, etc. to be able to remove liquids from the system that otherwise would create problems for the instruments.</obo:IAO_0000115>
        <rdfs:label>drain port</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000888 -->


