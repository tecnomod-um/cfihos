            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000881</hasCFIHOSCode>
        <obo:IAO_0000115>A large flat-bottomed boat that is built for carrying goods and people on rivers and canals or in harbours, with or without sails, towed by a tug or horse. Also a similar boat with its own engine.</obo:IAO_0000115>
        <rdfs:label>barge</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000882 -->


