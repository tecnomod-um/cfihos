            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000882</hasCFIHOSCode>
        <obo:IAO_0000115>A regulator ensuring constant volume in a HVAC system to reduce noise</obo:IAO_0000115>
        <rdfs:label>constant volume regulator</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000883 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000883">
