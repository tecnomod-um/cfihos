    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000135 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000135">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000099"/>
