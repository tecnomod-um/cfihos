        <hasCFIHOSCode>CFIHOS-30000720</hasCFIHOSCode>
        <obo:IAO_0000115>A device intended to prevent excessive jacket penetration into the soil.</obo:IAO_0000115>
        <rdfs:label>subsea mudmat</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000721 -->


