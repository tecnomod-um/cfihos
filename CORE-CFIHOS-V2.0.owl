        <hasCFIHOSCode>CFIHOS-30000016</hasCFIHOSCode>
        <obo:IAO_0000115>A mechanical device made for keeping objects firmly in place or position, temporary or permanently.</obo:IAO_0000115>
        <rdfs:label>clamp</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000017 -->


