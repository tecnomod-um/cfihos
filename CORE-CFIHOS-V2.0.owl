                <owl:someValuesFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000084"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000497</hasCFIHOSCode>
        <obo:IAO_0000115>A physical object that is used to change piping direction with a non-standard radius.</obo:IAO_0000115>
        <rdfs:label>pipe bend</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000498 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000498">
