        <schema:identifier>1453</schema:identifier>
        <rdfs:label>regulatory compliance certificate</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000081 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000081">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000081</hasCFIHOSCode>
        <obo:IAO_0000115>A specific standard documenting additional design, construction, work process, and documentation of plant as required by local regulations. This document type shall not be used to classify the engineering technical standards (e.g. API, ISO, etc.).</obo:IAO_0000115>
        <schema:identifier>7877</schema:identifier>
        <rdfs:label>country regulation specific standard</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000082 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000082">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000082</hasCFIHOSCode>
        <obo:IAO_0000115>A technical document describing the facilities that are proposed to be built in a country and includes all information required for regulatory approval to proceed. The document is submitted to the regulatory authorities for review and approval.</obo:IAO_0000115>
        <schema:identifier>7878</schema:identifier>
        <rdfs:label>country regulation technical project documentation book</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000083 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000083">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000083</hasCFIHOSCode>
        <obo:IAO_0000115>Data stored in a proprietary (e.g. SPI Watcom) or neutral (e.g. CSV) format from which multiple information contents can be generated by computer software (e.g. EDW). Includes &apos;3D model&apos;.</obo:IAO_0000115>
        <schema:identifier>1979</schema:identifier>
        <rdfs:label>database and data set</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000084 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000084">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000084</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular activities and requirements will be executed and delivered to decommission and demolish (parts of) existing assets. This would include temporary assets required only for the life of the project, as well.</obo:IAO_0000115>
        <schema:identifier>5801</schema:identifier>
        <rdfs:label>decommissioning plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000085 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000085">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000085</hasCFIHOSCode>
        <obo:IAO_0000115>A document that demonstrates that the design meets the process safety basic requirements with evidences and references to documents.</obo:IAO_0000115>
        <schema:identifier>3322</schema:identifier>
        <rdfs:label>demonstration note on compliance</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000086 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000086">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000086</hasCFIHOSCode>
        <obo:IAO_0000115>A calculations prepared in order to prove that the item of equipment or system selected meets the design criteria.</obo:IAO_0000115>
        <schema:identifier>1206</schema:identifier>
        <rdfs:label>design calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000087 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000087">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000087</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing model output defining the process design cases and sensitivity cases for process modelling.</obo:IAO_0000115>
        <schema:identifier>8240</schema:identifier>
        <rdfs:label>design cases study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000088 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000088">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000088</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining purpose and approach for a HSE design. Demonstrates ALARP.</obo:IAO_0000115>
        <schema:identifier>7506</schema:identifier>
        <rdfs:label>design hse case</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000089 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000089">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000089</hasCFIHOSCode>
        <obo:IAO_0000115>A document assessing different physical configurations of a set of equipment and explaining the rationale supporting the adoption of a particular layout.</obo:IAO_0000115>
        <schema:identifier>8218</schema:identifier>
        <rdfs:label>design layout study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000091 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000091">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000091</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for decisions that are to be followed regarding a design. A set of ideas, beliefs, or underlying theory.</obo:IAO_0000115>
        <schema:identifier>5507</schema:identifier>
        <rdfs:label>design philosophy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000092 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000092">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000092</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting verification of a design, based on comparison with standards, constructability, operability, safety, etc. May be performed by internal or external resources.</obo:IAO_0000115>
        <schema:identifier>7403</schema:identifier>
        <rdfs:label>design review report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000094 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000094">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000094</hasCFIHOSCode>
        <obo:IAO_0000115>A consolidated document describing discipline specific activities and deliverables and their criticality to drive appropriate review processes.  This is a starting point for document distribution matrix stating quality assurance and control requirements.</obo:IAO_0000115>
        <schema:identifier>5806</schema:identifier>
        <rdfs:label>discipline delivery plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000096 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000096">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000096</hasCFIHOSCode>
        <obo:IAO_0000115>A document providing an overview of distribution (workflow) process for information. Often a report out of a electronic document management system.</obo:IAO_0000115>
        <schema:identifier>6610</schema:identifier>
        <rdfs:label>document distribution matrix</rdfs:label>
        <skos:altLabel>information distribution matrix (IDM)</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000097 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000097">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000097</hasCFIHOSCode>
        <obo:IAO_0000115>Specification of the Information types required by the owner for delivery and handover.</obo:IAO_0000115>
        <schema:identifier>7712</schema:identifier>
        <rdfs:label>information requirements specification</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000098 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000098">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000098</hasCFIHOSCode>
        <obo:IAO_0000115>A procedure specifically for document and data control (&apos;information management&apos;). Includes &apos;document control&apos; charts and other procedure components.</obo:IAO_0000115>
        <schema:identifier>6017</schema:identifier>
        <rdfs:label>document, data control procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000099 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000099">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000099</hasCFIHOSCode>
        <obo:IAO_0000115>A register (at &apos;document&apos;, not &apos;document type&apos; level) of the information delivered on the project, including all deliverables which receive a document number including but not limited to drawings, lists, applications, databases, and models provided by &apos;contractor&apos; or &apos;vendor&apos; to satisfy &apos;company&apos; requirements.</obo:IAO_0000115>
        <schema:identifier>6611</schema:identifier>
        <rdfs:label>master document register</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000100 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000100">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000100</hasCFIHOSCode>
        <obo:IAO_0000115>Rules and conventions for preparing drawings, including symbol lists, etc. may include drawing templates.</obo:IAO_0000115>
        <schema:identifier>7772</schema:identifier>
        <rdfs:label>drafting specification</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000102 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000102">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000102</hasCFIHOSCode>
        <obo:IAO_0000115>A schematic representation of an HVAC system indicating all HVAC equipment items and their control interfaces.  Abbreviation is typically D&amp;ID.</obo:IAO_0000115>
        <schema:identifier>2409</schema:identifier>
        <rdfs:label>ducting and instrument diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000103 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000103">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000103</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing earthing (grounding) for plant and equipment and between modules and dissimilar structural elements.</obo:IAO_0000115>
        <schema:identifier>8809</schema:identifier>
        <rdfs:label>earthing diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000105 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000105">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000105</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing escape routes, means of emergency escape/egress.</obo:IAO_0000115>
        <schema:identifier>2318</schema:identifier>
        <rdfs:label>emergency exits diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000106 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000106">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000106</hasCFIHOSCode>
        <obo:IAO_0000115>A procedure detailing how the facility would respond to an emergency and how personnel would be able to evacuate. As defined for &apos;facilities operations&apos; and for &apos;pipeline operations&apos;.</obo:IAO_0000115>
        <schema:identifier>6019</schema:identifier>
        <rdfs:label>emergency response procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000108 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000108">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000108</hasCFIHOSCode>
        <obo:IAO_0000115>A report detailing accumulated environmental emissions over a set period of time.</obo:IAO_0000115>
        <schema:identifier>1909</schema:identifier>
        <rdfs:label>emissions report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000109 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000109">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000109</hasCFIHOSCode>
        <obo:IAO_0000115>A time-based document outlining order in which tasks are to be carried out and the amounts of time allocated to them.  Addresses design phase as well as engineering support during manufacturing, construction, tie-in, test/inspect, shutdown.</obo:IAO_0000115>
        <schema:identifier>5722</schema:identifier>
        <rdfs:label>engineering schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000111 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000111">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000111</hasCFIHOSCode>
        <obo:IAO_0000115>An assessment which details the impact of facility on the surrounding environment.</obo:IAO_0000115>
        <schema:identifier>0702</schema:identifier>
        <rdfs:label>environmental impact assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000112 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000112">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000112</hasCFIHOSCode>
        <obo:IAO_0000115>Report demonstrating compliance with local regulations and law.</obo:IAO_0000115>
        <schema:identifier>2701</schema:identifier>
        <rdfs:label>regulatory compliance report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000113 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000113">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000113</hasCFIHOSCode>
        <obo:IAO_0000115>Shall include a brief description of &apos;vendor&apos;s&apos; documented &apos;environmental management system&apos; showing how the system is structured and reference to the standard on which it is based (e.g. ISO 14001 or similar).</obo:IAO_0000115>
        <schema:identifier>6852</schema:identifier>
        <rdfs:label>environmental management system description</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000115 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000115">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000115</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting production criticality rating of equipment, sparing, maintenance testing and inspection requirements, spare parts requirements etc. Will feed into maintenance reference plan.</obo:IAO_0000115>
        <schema:identifier>3004</schema:identifier>
        <rdfs:label>equipment production criticality rating report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000116 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000116">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000116</hasCFIHOSCode>
        <obo:IAO_0000115>A sliced view of a part or component that shows its internal make up.</obo:IAO_0000115>
        <schema:identifier>2320</schema:identifier>
        <rdfs:label>equipment cross section diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000117 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000117">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000117</hasCFIHOSCode>
        <obo:IAO_0000115>A datasheet which provides precise information about a  tag and compliments equipment specification.</obo:IAO_0000115>
        <schema:identifier>2105</schema:identifier>
        <rdfs:label>design datasheet</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000118 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000118">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000118</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram not otherwise described in another document type.  Not to be used if a more specific document type can be used.  Can be used for singular/specialty deliverables which do not have a unique document type.</obo:IAO_0000115>
        <schema:identifier>2321</schema:identifier>
        <rdfs:label>general diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000119 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000119">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000119</hasCFIHOSCode>
        <obo:IAO_0000115>Installation refers to the mounting, setting, erection, etc. of equipment and accessories. These diagrams are for transient activity during installation (eg. sequence of activity) and not finished work.</obo:IAO_0000115>
        <schema:identifier>2322</schema:identifier>
        <rdfs:label>installation diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000122 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000122">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000122</hasCFIHOSCode>
        <obo:IAO_0000115>An authoritative collection of values with a relationship to a specific equipment or tag.  The columns of this collection is specified and controlled.</obo:IAO_0000115>
        <schema:identifier>6612</schema:identifier>
        <rdfs:label>master tag-equipment register</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000126 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000126">
