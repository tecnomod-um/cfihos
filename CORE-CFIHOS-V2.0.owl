    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000103">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000013"/>
