        <hasCFIHOSCode>CFIHOS-30000670</hasCFIHOSCode>
        <obo:IAO_0000115>A device that is designed for easy washing and dope application of drill pipe threads and collar threads.</obo:IAO_0000115>
        <rdfs:label>pipe doping machine</rdfs:label>
    </owl:Class>
    


