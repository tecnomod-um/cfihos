        <hasCFIHOSCode>CFIHOS-30000014</hasCFIHOSCode>
        <obo:IAO_0000115>Is a shaft (civil) intended to transport flue gas to a high location in the atmosphere. It may also be used to supply fresh air via a separate flue.</obo:IAO_0000115>
        <rdfs:label>chimney</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000016 -->


