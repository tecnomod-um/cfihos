        <hasCFIHOSCode>CFIHOS-30000496</hasCFIHOSCode>
        <obo:IAO_0000115>A physical object that is a long tube or hollow body intended for conduction of liquid, gaseous or finely divided solid materials, or used for structural purposes.</obo:IAO_0000115>
        <rdfs:label>pipe</rdfs:label>
        <skos:altLabel>line</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000497 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000497">
