        <hasCFIHOSCode>CFIHOS-70000057</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing assembly and fabrication.</obo:IAO_0000115>
        <schema:identifier>2404</schema:identifier>
        <rdfs:label>construction diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000060 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000060">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000060</hasCFIHOSCode>
        <obo:IAO_0000115>A time-based document outlining sequence and duration of activities related to the completion of construction scope.  Construction includes site erection and assembly but not fabrication at third party sites.</obo:IAO_0000115>
        <schema:identifier>5802</schema:identifier>
        <rdfs:label>construction schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000062 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000062">
