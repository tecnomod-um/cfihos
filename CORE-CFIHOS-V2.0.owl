            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000498</hasCFIHOSCode>
        <obo:IAO_0000115>A physical object that is a circular plate with no central opening and holes to match mating flanged ends. It is also equipped with a handle.</obo:IAO_0000115>
        <rdfs:label>pipe flange spade</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000499 -->


