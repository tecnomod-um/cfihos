        <hasCFIHOSCode>CFIHOS-70000043</hasCFIHOSCode>
        <obo:IAO_0000115>A consolidated register of proposed and/or processed change associated with all change to originally agreed design scope/statement of requirements, including basis for design.</obo:IAO_0000115>
        <schema:identifier>6605</schema:identifier>
        <rdfs:label>change control register</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000044 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000044">
