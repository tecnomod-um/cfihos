        <hasCFIHOSCode>CFIHOS-70000363</hasCFIHOSCode>
        <obo:IAO_0000115>A document which describes a set of logically sequenced instructions to execute a weld repair.</obo:IAO_0000115>
        <schema:identifier>6064</schema:identifier>
        <rdfs:label>welding repair procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000365 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000365">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000365</hasCFIHOSCode>
        <obo:IAO_0000115>A document formally establishing scope of work into smaller manageable blocks to manage cost and schedule control.</obo:IAO_0000115>
        <schema:identifier>5792</schema:identifier>
        <rdfs:label>work breakdown structure specification</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000366 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000366">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000366</hasCFIHOSCode>
        <obo:IAO_0000115>Step by step instruction for the accomplishment of a task. more detailed than a procedure.</obo:IAO_0000115>
        <schema:identifier>3375</schema:identifier>
        <rdfs:label>work instruction</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000367 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000367">
