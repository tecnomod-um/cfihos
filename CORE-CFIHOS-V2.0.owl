        <schema:identifier>6048</schema:identifier>
        <rdfs:label>communication procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000055 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000055">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000055</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing details of cable numbers and terminations point to point (e.g., to/from vendor packages, equipment).</obo:IAO_0000115>
        <schema:identifier>8804</schema:identifier>
        <rdfs:label>connection diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000057 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000057">
