        <obo:IAO_0000115>A high carbon variant of 316 stainless steel with improved strength at high temperatures, used for pressure vessels and boilers32.</obo:IAO_0000115>
        <rdfs:label>316H SS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000054 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000054">
