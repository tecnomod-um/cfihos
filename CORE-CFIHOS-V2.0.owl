        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A conveyor comprising a series of closely spaced rollers set so that their crests can support articles to be conveyed. They may be power-driven, or freely revolving. Tapered rollers are used to form bends in the conveyor line.</obo:IAO_0000115>
        <rdfs:label>roller conveyor</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000570 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000570">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000564"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://infohub.siemens-energy.com/CFIHOS#hasTag"/>
                <owl:someValuesFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000570"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000570</hasCFIHOSCode>
        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A conveyor consisting of a series of slats generally made of metal or wood  attached to an endless chain.</obo:IAO_0000115>
        <rdfs:label>slat conveyor</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000571 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000571">
