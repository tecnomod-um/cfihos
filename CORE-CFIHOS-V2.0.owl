        <obo:IAO_0000115>A document detailing the dispersion of atmospheric releases from flaring, venting, and exhaust from compressors and machinery as well as dispersion of leaks to ground or water.</obo:IAO_0000115>
        <schema:identifier>8202</schema:identifier>
        <rdfs:label>dispersion study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000022 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000022">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000022</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular audits and assessments will be carried out to achieve the overall quality program.  May include an overview schedule highlighting activities.</obo:IAO_0000115>
        <schema:identifier>5707</schema:identifier>
        <rdfs:label>audit plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000023 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000023">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000023</hasCFIHOSCode>
        <obo:IAO_0000115>A list or register of people or organisations authorised to perform a range of tasks which may be technical, financial, contractual, organisational, or other. Includes Technical Authorities Matrix, Roles and Responsibilities, RACI/RASCI.</obo:IAO_0000115>
        <schema:identifier>6603</schema:identifier>
        <rdfs:label>authority matrix</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000024 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000024">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000024</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise for decisions and the resulting principles that are to be followed regarding the design of the facility and comprising all process design philosophies including but not limited to environmental, drainage, ventilation, spading/isolation, plant availability/down time assessment and relief/blowdown philosophy etc.</obo:IAO_0000115>
        <schema:identifier>7704</schema:identifier>
        <rdfs:label>basis of design</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000025 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000025">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000025</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise for decisions and the resulting principles that are to be followed regarding estimates. This document should be updated with each formal update of the project cost estimate, particularly at each stage gate. As much detail as possible should be provided in the document, relative to the scope definition available for the compilation of the estimate.</obo:IAO_0000115>
        <schema:identifier>7179</schema:identifier>
        <rdfs:label>basis of estimate</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000026 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000026">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000026</hasCFIHOSCode>
        <obo:IAO_0000115>A document assessing the practicality and/or economics of a proposed solution.</obo:IAO_0000115>
        <schema:identifier>8203</schema:identifier>
        <rdfs:label>feasibility study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000027 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000027">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000027</hasCFIHOSCode>
        <obo:IAO_0000115>A data set used to evaluate or judge project estimates and or performance relative to it (i.e., ISO 19008).</obo:IAO_0000115>
        <schema:identifier>1905</schema:identifier>
        <rdfs:label>benchmarking data</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000028 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000028">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000028</hasCFIHOSCode>
        <obo:IAO_0000115>A list of all parts and sub assemblies that constitute a particular assembly, showing the quantity of each required item. Typically developed from analyzing a drawing.</obo:IAO_0000115>
        <schema:identifier>4306</schema:identifier>
        <rdfs:label>bill of materials</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000029 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000029">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000029</hasCFIHOSCode>
        <obo:IAO_0000115>A consolidated list of assemblies or bulk material showing the quantity of each required to suit a purpose. Use &apos;bill of materials&apos; for sub assemblies and parts.</obo:IAO_0000115>
        <schema:identifier>3309</schema:identifier>
        <rdfs:label>bill of quantities</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000030 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000030">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000030</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting the review results from 3D review addressing steelwork structure, equipment envelopes, escape routes, building envelopes, envelopes for main piping, HVAC and cable rack runs, preliminary road layouts, etc.</obo:IAO_0000115>
        <schema:identifier>7402</schema:identifier>
        <rdfs:label>three dimensional model review report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000033 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000033">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000033</hasCFIHOSCode>
        <obo:IAO_0000115>A collection of values relating to List of all cables, their specifications and end points. Indicates salient features of all cables in Vendor&apos;s supply and connecting cables supplied by Principal.</obo:IAO_0000115>
        <schema:identifier>4308</schema:identifier>
        <rdfs:label>cable schedule</rdfs:label>
        <skos:altLabel>cable list</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000034 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000034">
