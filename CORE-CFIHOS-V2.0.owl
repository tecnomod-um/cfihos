        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A physical object that consists of two discs with equal thickness and outer diameter connected with a flat bar. One of the discs has a hole, while the other disc is without hole.</obo:IAO_0000115>
        <rdfs:label>spectacle blind</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000504 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000504">
