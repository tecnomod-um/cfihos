        <hasCFIHOSCode>CFIHOS-70000190</hasCFIHOSCode>
        <obo:IAO_0000115>A register documenting agreements and responsibilities between internal and external parties (esp. between contract scopes).</obo:IAO_0000115>
        <schema:identifier>6627</schema:identifier>
        <rdfs:label>interface register</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000191 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000191">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000191</hasCFIHOSCode>
        <obo:IAO_0000115>A standardised document by which the Company invites Tenderers to submit a tender for a Contract. It encloses the conditions for the submission of a tender and gives the terms of reference or the technical qualifications required.</obo:IAO_0000115>
        <schema:identifier>3330</schema:identifier>
        <rdfs:label>invitation to tender</rdfs:label>
        <skos:altLabel>request for proposal (rfp)</skos:altLabel>
        <skos:altLabel>request for quotation (rfq)</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000192 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000192">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000192</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for isolation philosophy for safe plant operation and maintenance.</obo:IAO_0000115>
        <schema:identifier>5517</schema:identifier>
        <rdfs:label>isolation philosophy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000193 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000193">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000193</hasCFIHOSCode>
        <obo:IAO_0000115>Construction detail diagram for &apos;piping and ducting&apos;, providing an accurate &apos;bill of materials&apos; (BOM) / &apos;material take off&apos; (MTO) and represented in a 3 dimensional isometric view.</obo:IAO_0000115>
        <schema:identifier>2343</schema:identifier>
        <rdfs:label>isometric diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000196 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000196">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000196</hasCFIHOSCode>
        <obo:IAO_0000115>A plan view diagram of a plant/group of plants showing the interfaces of layout diagrams of components.  Typically only shows major equipment and infrastructure to provide context and orientation.</obo:IAO_0000115>
        <schema:identifier>4024</schema:identifier>
        <rdfs:label>key plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000197 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000197">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000197</hasCFIHOSCode>
        <obo:IAO_0000115>A report which documents lessons gained from the execution of the project.</obo:IAO_0000115>
        <schema:identifier>7417</schema:identifier>
        <rdfs:label>lessons learned report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000199 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000199">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000199</hasCFIHOSCode>
        <obo:IAO_0000115>A study determine needs for cranes and handling equipment access for project phase also access and cost related considerations to be made.  Including project related materials handling and bulk handling.</obo:IAO_0000115>
        <schema:identifier>8236</schema:identifier>
        <rdfs:label>lifting study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000200 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000200">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000200</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular activities and requirements will be executed and delivered for lifting, hoisting, and rigging.  Should cover scope regardless of timing in asset lifecycle.  Specific risks relating to simultaneous operations should be addressed.</obo:IAO_0000115>
        <schema:identifier>5736</schema:identifier>
        <rdfs:label>lifting, hoisting, and rigging plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000203 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000203">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000203</hasCFIHOSCode>
        <obo:IAO_0000115>An authoritative collection of electrical loads which the electrical system must accommodate listed against each piece of equipment.  The columns of this collection are specified and controlled.</obo:IAO_0000115>
        <schema:identifier>4329</schema:identifier>
        <rdfs:label>load list</rdfs:label>
        <skos:altLabel>load schedule</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000204 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000204">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000204</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting  assumptions and method determining computer analysis to verify the module design for loadout/in condition.</obo:IAO_0000115>
        <schema:identifier>0520</schema:identifier>
        <rdfs:label>loadout and loadin analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000205 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000205">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000205</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing details all elements of a control loop, from sensing element through to controlling element, and cabling and wiring details for the associated instruments. Includes junction box, marshalling cabinet and control panel terminations and power supply details.</obo:IAO_0000115>
        <schema:identifier>2347</schema:identifier>
        <rdfs:label>loop diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000206 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000206">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000206</hasCFIHOSCode>
        <obo:IAO_0000115>A document that describes methods of maintaining a specific piece of equipment.  Typically originates from the equipment or package supplier.</obo:IAO_0000115>
        <schema:identifier>4810</schema:identifier>
        <rdfs:label>maintenance manual</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000208 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000208">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000208</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing current and predicted manpower through project broken down by trade/profession.</obo:IAO_0000115>
        <schema:identifier>3341</schema:identifier>
        <rdfs:label>manpower histogram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000211 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000211">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000211</hasCFIHOSCode>
        <obo:IAO_0000115>A datasheet which summarizes of physical and chemical properties of the substance - description of its harmful nature including potential impact on the health and safety of personnel and of the environment - precautions necessary to ensure its safe use and eventual disposal.</obo:IAO_0000115>
        <schema:identifier>2107</schema:identifier>
        <rdfs:label>safety datasheet</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000212 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000212">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000212</hasCFIHOSCode>
        <obo:IAO_0000115>A schematic diagram (ie. typically a layer on a PFS/PFD or PEFS/P&amp;ID) showing materials selected for each component of the design. May include piping class breaks (eg. CS/SS316) and vessel internals (e.g. CS epoxy lined). Includes corrosion loop diagrams that show boundary definitions.</obo:IAO_0000115>
        <schema:identifier>2349</schema:identifier>
        <rdfs:label>material selection diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000215 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000215">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000215</hasCFIHOSCode>
        <obo:IAO_0000115>A study describes materials and reasons for selecting those materials (e.g. environmental conditions). Considered a precursor to the &apos;MS report&apos; and &apos;MS diagram&apos;, where used.</obo:IAO_0000115>
        <schema:identifier>8241</schema:identifier>
        <rdfs:label>material selection study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000217 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000217">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000217</hasCFIHOSCode>
        <obo:IAO_0000115>Location plans/records with an identification system cross referring to the individual material certificates.</obo:IAO_0000115>
        <schema:identifier>5011</schema:identifier>
        <rdfs:label>material traceability report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000218 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000218">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000218</hasCFIHOSCode>
        <obo:IAO_0000115>A study identify the most appropriate mechanical handling equipment (cranes, hoists, forklift trucks, etc.) for operations and maintenance phase for the facilities.</obo:IAO_0000115>
        <schema:identifier>8370</schema:identifier>
        <rdfs:label>mechanical handling equipment study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000219 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000219">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000219</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for the metering and allocation philosophy for fiscal measurement for the purpose of sales or purchase relating to utilities and/or products/feedstocks.</obo:IAO_0000115>
        <schema:identifier>5520</schema:identifier>
        <rdfs:label>metering philosophy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000220 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000220">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000220</hasCFIHOSCode>
        <obo:IAO_0000115>A study providing an analysis of metocean data.</obo:IAO_0000115>
        <schema:identifier>8375</schema:identifier>
        <rdfs:label>metocean analysis study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000221 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000221">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000221</hasCFIHOSCode>
        <obo:IAO_0000115>A study providing the metocean design and operating conditions for the proposed offshore facilities. This document should give a complete overview of all existing metocean data (wind, waves, currents, water level and weather data) and mention all existing metocean study reports.</obo:IAO_0000115>
        <schema:identifier>8379</schema:identifier>
        <rdfs:label>metocean reference document study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000222 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000222">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000222</hasCFIHOSCode>
        <obo:IAO_0000115>A report describing how, when and where metocean data has been collected.  Includes bathymetric data.</obo:IAO_0000115>
        <schema:identifier>8421</schema:identifier>
        <rdfs:label>metocean survey</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000223 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000223">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000223</hasCFIHOSCode>
        <obo:IAO_0000115>A summary of a meeting highlighting attendees, status, committed action items and issues. Minutes of meetings between client and contractor as requested in contract procedures.</obo:IAO_0000115>
        <schema:identifier>3347</schema:identifier>
        <rdfs:label>minutes of meeting</rdfs:label>
        <skos:altLabel>conference notes</skos:altLabel>
        <skos:altLabel>meeting notes</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000225 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000225">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000225</hasCFIHOSCode>
        <obo:IAO_0000115>A datasheet which provides information about the noise limits for the equipment to be supplied.</obo:IAO_0000115>
        <schema:identifier>2110</schema:identifier>
        <rdfs:label>noise datasheet</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000226 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000226">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000226</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting the condition of any product or component in which one or more characteristics do not conform to requirements. Includes failures, deficiencies, defects and malfunctions. Is often identified during an audit.</obo:IAO_0000115>
        <schema:identifier>6918</schema:identifier>
        <rdfs:label>non conformance report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000227 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000227">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000227</hasCFIHOSCode>
        <obo:IAO_0000115>A procedure detailing all non-destructive tests/examinations. Excludes pressure tests.</obo:IAO_0000115>
        <schema:identifier>6038</schema:identifier>
        <rdfs:label>non destructive test procedure</rdfs:label>
        <skos:altLabel>non destructive examination procedure</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000228 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000228">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000228</hasCFIHOSCode>
        <obo:IAO_0000115>A document that describes methods of operating a piece of equipment or process unit, including but not limited to Instructions, procedures, drawings, tables, etc. for the operation -stop, start, and emergency shutdown. Including operational limits, function testing, possible interruptions, corrective actions, hazards and corrective measures to be taken.</obo:IAO_0000115>
        <schema:identifier>4811</schema:identifier>
        <rdfs:label>operating manual</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000230 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000230">
