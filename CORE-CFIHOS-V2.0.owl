                <owl:someValuesFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000886"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000886</hasCFIHOSCode>
        <obo:IAO_0000115>A device that provides a safe and rapid method of descent in case of an emergency situation requiring evacuation.</obo:IAO_0000115>
        <rdfs:label>descent device</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000887 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000887">
