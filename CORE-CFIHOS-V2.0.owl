            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000878</hasCFIHOSCode>
        <obo:IAO_0000115>An enclosure that totally or partially surrounds an item in order to reduce its emitted noise.</obo:IAO_0000115>
        <rdfs:label>acoustic enclosure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000879 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000879">
