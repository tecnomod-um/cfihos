            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000879</hasCFIHOSCode>
        <obo:IAO_0000115>A trap which, by a water seal, prevents foul air from rising from sinks, wash basins, drains, sewers etc.</obo:IAO_0000115>
        <rdfs:label>air trap</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000881 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000881">
