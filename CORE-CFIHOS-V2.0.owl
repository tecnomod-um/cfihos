        <hasCFIHOSCode>CFIHOS-70000126</hasCFIHOSCode>
        <obo:IAO_0000115>A customized list developed to support discipline activities, extract from a Register that is used as a secondary reference (i.e. not the master). Considers all potential disciplines. Covers: conduits, panels, pipe supports, piping speciality items, lighting, etc.</obo:IAO_0000115>
        <schema:identifier>4322</schema:identifier>
        <rdfs:label>equipment list</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000127 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000127">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000127</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for decisions that are to be followed regarding a selection of rotating equipment. Typically provided as instruction from &apos;owner operator&apos;.</obo:IAO_0000115>
        <schema:identifier>5510</schema:identifier>
        <rdfs:label>equipment type selection philosophy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000129 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000129">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000129</hasCFIHOSCode>
        <obo:IAO_0000115>An assessment which details the emergency evacuation and rescue means from a facility.</obo:IAO_0000115>
        <schema:identifier>0703</schema:identifier>
        <rdfs:label>escape, evacuation, rescue assessment</rdfs:label>
    </owl:Class>
    


