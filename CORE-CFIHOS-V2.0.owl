        <hasCFIHOSCode>CFIHOS-70000346</hasCFIHOSCode>
        <obo:IAO_0000115>A list describing manually operated valves.  Not check valves, not motor operated valves, not control valves, not PSVs, as these are all captured elsewhere (see instrument index for relief devices and actuated valves).</obo:IAO_0000115>
        <schema:identifier>4368</schema:identifier>
        <rdfs:label>manual valve list</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000347 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000347">
