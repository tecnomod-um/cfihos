                <owl:onProperty rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-40000009"/>
                <owl:someValuesFrom rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000638</hasCFIHOSCode>
        <obo:IAO_0000115>A valve that can be used to modify (regulate) the fluid flow rate in a process control system. It usually includes an actuator, which responds to a signal from the controlling system and changes the position of the flow controlling element in the valve.</obo:IAO_0000115>
        <rdfs:label>control valve</rdfs:label>
