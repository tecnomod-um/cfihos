        <hasCFIHOSCode>CFIHOS-30000588</hasCFIHOSCode>
        <obo:IAO_0000115>A distillation column intended to clean gas by washing the gas flow with water or with another liquid entering at the top of the vessel and sprayed in the gas. Typically to remove dust and small particles.</obo:IAO_0000115>
        <rdfs:label>scrubber</rdfs:label>
        <skos:altLabel>scrubber column</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000590 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000590">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000230"/>
        <hasCFIHOSCode>CFIHOS-30000590</hasCFIHOSCode>
        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A physical object that is a layer or surface with a shape in two dimensions and length in the third dimension surrounding a space. Typically the cylindrical part of a vessel.</obo:IAO_0000115>
        <rdfs:label>shell</rdfs:label>
    </owl:Class>
    


