        <schema:identifier>2384</schema:identifier>
        <rdfs:label>single line diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000372 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000372">
