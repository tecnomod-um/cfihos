        <hasCFIHOSCode>CFIHOS-70000063</hasCFIHOSCode>
        <obo:IAO_0000115>A binding document which records a agreement and its related mutual obligations and commitments. Typically having effect on a project or the future life of a facility. For example a sales contract, maintenance contract, etc.</obo:IAO_0000115>
        <schema:identifier>0403</schema:identifier>
        <rdfs:label>contract</rdfs:label>
        <skos:altLabel>service order</skos:altLabel>
        <skos:altLabel>work order</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000064 -->


