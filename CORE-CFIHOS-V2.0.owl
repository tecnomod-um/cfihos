        <obo:IAO_0000115>A pilot switch whose function is controlled by variations of temperature and whose contacts make or break automatically a load circuit when the temperature of the ambient space in which its sensing element placed or the temperature of the surface on which it is fixed reaches a predetermined value.</obo:IAO_0000115>
        <rdfs:label>thermostatic switch</rdfs:label>
        <skos:altLabel>heat trace thermostat</skos:altLabel>
        <skos:altLabel>local controller</skos:altLabel>
        <skos:altLabel>thermostat</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000374 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000374">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000310"/>
