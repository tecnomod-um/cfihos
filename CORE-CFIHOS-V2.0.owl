        <hasCFIHOSCode>CFIHOS-70000048</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining purpose and approach for commissioning and start-up.</obo:IAO_0000115>
        <schema:identifier>5799</schema:identifier>
        <rdfs:label>commissioning and startup strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000051 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000051">
