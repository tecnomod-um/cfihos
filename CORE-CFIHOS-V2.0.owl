        <schema:identifier>6063</schema:identifier>
        <rdfs:label>weighing procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000357 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000357">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000357</hasCFIHOSCode>
        <obo:IAO_0000115>Includes mass, buoyancy, and calculations used in the design of weight coating (eg. on submerged pipelines).</obo:IAO_0000115>
        <schema:identifier>1231</schema:identifier>
        <rdfs:label>weight calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000358 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000358">
