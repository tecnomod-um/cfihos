     -->


    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000001 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000001">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000001</hasCFIHOSCode>
        <obo:IAO_0000115>A macro discipline covering the administrative and management related items associated with a major capital project, including organization, cross-engineering discipline philosophies, basis of design, regulatory activities, etc.</obo:IAO_0000115>
        <schema:identifier>AA</schema:identifier>
        <rdfs:label>project management and engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000002 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000002">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000002</hasCFIHOSCode>
        <obo:IAO_0000115>A macro discipline covering the specification and management of field installation and hook up of facilities.  May includes but is not limited to installation, transportation, fabrication, construction and mechanical completion related information.</obo:IAO_0000115>
        <schema:identifier>BA</schema:identifier>
        <rdfs:label>construction</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000003 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000003">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000003</hasCFIHOSCode>
        <obo:IAO_0000115>A civil engineering specialty addressing the design of buildings meant for occupancy.</obo:IAO_0000115>
        <schema:identifier>CB</schema:identifier>
        <rdfs:label>architectural engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000004 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000004">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000004</hasCFIHOSCode>
        <obo:IAO_0000115>A civil engineering specialty addressing the engineering behaviors of earth materials.</obo:IAO_0000115>
        <schema:identifier>CG</schema:identifier>
        <rdfs:label>geotechnical engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000005 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000005">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000005</hasCFIHOSCode>
        <obo:IAO_0000115>A civil engineering specialty addressing systems necessary to support a site, including but not limited to roads, ports, sewer, utilities, and power.</obo:IAO_0000115>
        <schema:identifier>CI</schema:identifier>
        <rdfs:label>infrastructure engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000006 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000006">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000006</hasCFIHOSCode>
        <obo:IAO_0000115>A civil engineering specialty addressing the design of structures which resist loads, specifically constructed of concrete and steel.</obo:IAO_0000115>
        <schema:identifier>CS</schema:identifier>
        <rdfs:label>structural engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000007 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000007">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000007</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the design and maintenance of earthworks, including but not limited to levees, berms, grade, and drainage.</obo:IAO_0000115>
        <schema:identifier>CX</schema:identifier>
        <rdfs:label>civil engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000008 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000008">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000008</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the design and application of circuitry and equipment for power generation and distribution</obo:IAO_0000115>
        <schema:identifier>EA</schema:identifier>
        <rdfs:label>electrical engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000009 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000009">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000009</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the management of project cost and schedule, involving such activities as estimating, cost control, cost and schedule forecasting, investment appraisal and risk analysis</obo:IAO_0000115>
        <schema:identifier>FA</schema:identifier>
        <rdfs:label>cost and planning management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000010 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000010">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000010</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the interface between capital project and the natural environment, specifically addressing risk analysis and mitigation to impact to air, water, flora and fauna.</obo:IAO_0000115>
        <schema:identifier>HE</schema:identifier>
        <rdfs:label>environmental</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000011 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000011">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000011</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the health and welfare of personnel engaged in work or employment</obo:IAO_0000115>
        <schema:identifier>HH</schema:identifier>
        <rdfs:label>health</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000012 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000012">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000012</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing assessment of condition, analysis of risk and mitigation of potential harm to physical assets from external forces.</obo:IAO_0000115>
        <schema:identifier>HP</schema:identifier>
        <rdfs:label>security</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000013 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000013">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000013</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing assessment of condition, analysis of risk and mitigation of potential harm to personnel as a result of their working conditions or behaviors</obo:IAO_0000115>
        <schema:identifier>HS</schema:identifier>
        <rdfs:label>safety</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000014 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000014">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000014</hasCFIHOSCode>
        <obo:IAO_0000115>A macro discipline used to classify content generally addressing a combination of &apos;safety&apos;, &apos;security&apos;, &apos;health&apos; and &apos;environmental&apos;, or any combination thereof.</obo:IAO_0000115>
        <schema:identifier>HX</schema:identifier>
        <rdfs:label>health, safety, environmental and security</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000015 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000015">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000015</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the design and application of monitoring and control systems.</obo:IAO_0000115>
        <schema:identifier>IN</schema:identifier>
        <rdfs:label>instrumentation engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000016 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000016">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000016</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the collection and management of information both in document and data formats</obo:IAO_0000115>
        <schema:identifier>JA</schema:identifier>
        <rdfs:label>information management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000017 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000017">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000017</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing internal networks, security, and equipment to store, retrieve, transmit and manipulate data at a facility, etc.  Specifically excluded facility control systems.</obo:IAO_0000115>
        <schema:identifier>KA</schema:identifier>
        <rdfs:label>information technology</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000018 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000018">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000018</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the systems that are used to transport liquids and gases. Including but not limited to pipeline design hydraulics, routes &amp; stability,specification and other accessories such as cathodic protection, pigging equipment etc.</obo:IAO_0000115>
        <schema:identifier>LA</schema:identifier>
        <rdfs:label>pipeline engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000019 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000019">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000019</hasCFIHOSCode>
        <obo:IAO_0000115>A mechanical engineering specialty addressing the design and application of systems for heating, ventilation, and/or air-conditioning (HVAC)</obo:IAO_0000115>
        <schema:identifier>MH</schema:identifier>
        <rdfs:label>heating, ventilating, and air conditioning</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000020 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000020">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000020</hasCFIHOSCode>
        <obo:IAO_0000115>A mechanical engineering specialty addressing the design, routing, and control of flow inside process and utilities via piping and related specialty equipment</obo:IAO_0000115>
        <schema:identifier>MP</schema:identifier>
        <rdfs:label>piping engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000021 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000021">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000021</hasCFIHOSCode>
        <obo:IAO_0000115>A mechanical engineering specialty addressing mechanical components used to add kinetic energy to any process in order to make a material move. The equipment may include pumps, turbines, gearboxes, compressors, engines, etc.</obo:IAO_0000115>
        <schema:identifier>MR</schema:identifier>
        <rdfs:label>mechanical rotating engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000022 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000022">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000022</hasCFIHOSCode>
        <obo:IAO_0000115>A mechanical engineering specialty addressing mechanical equipment with no rotating components.  The equipment may include tanks, vessels, heat exchangers, and fired equipment such as furnaces and boilers.</obo:IAO_0000115>
        <schema:identifier>MS</schema:identifier>
        <rdfs:label>mechanical static engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000023 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000023">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000023</hasCFIHOSCode>
        <obo:IAO_0000115>A macro discipline used to classify content generally addressing a combination of &apos;piping&apos;, HVAC, &apos;rotating&apos;, or &apos;static equipment&apos;, or any combination thereof.</obo:IAO_0000115>
        <schema:identifier>MX</schema:identifier>
        <rdfs:label>mechanical engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000024 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000024">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000024</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing equipment reliability and planning required to maintain the equipment and other infrastructure. Includes procedures, spares, etc.</obo:IAO_0000115>
        <schema:identifier>NA</schema:identifier>
        <rdfs:label>maintenance management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000025 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000025">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000025</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline related to the planning, scheduling and future operations management post turnover. Including but not limited to training materials, procedures, strategies, organization design, etc.</obo:IAO_0000115>
        <schema:identifier>OA</schema:identifier>
        <rdfs:label>operations management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000026 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000026">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000026</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline related to the design, operation, control, and optimization of chemical, physical, and biological processes. Including but not limited to process flow definition, process modeling, etc.</obo:IAO_0000115>
        <schema:identifier>PX</schema:identifier>
        <rdfs:label>process engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000027 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000027">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000027</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing quality planning, assurance, control and improvement.</obo:IAO_0000115>
        <schema:identifier>QA</schema:identifier>
        <rdfs:label>quality management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000028 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000028">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000028</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing material selection and methods to manage integrity for the facility lifecycle, including corrosion management through coatings, linings, cathodic protection, inhibition, weld procedures, etc.</obo:IAO_0000115>
        <schema:identifier>RA</schema:identifier>
        <rdfs:label>materials engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000029 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000029">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000029</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the management of the transport, storage, distribution, and warehousing of materials and finished goods.  May also include transport and logistics of personnel, where applicable.</obo:IAO_0000115>
        <schema:identifier>SA</schema:identifier>
        <rdfs:label>logistics management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000030 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000030">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000030</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing external communication systems.  This typically includes, any systems or equipment used for transmission of information across a distance, such as coax cable, optical fiber, radio, dish, etc.</obo:IAO_0000115>
        <schema:identifier>TA</schema:identifier>
        <rdfs:label>telecommunications</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000031 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000031">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000031</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing design and control of production systems to be installed on the sea floor as well as any support equipment which tether those systems to a facility. Including but not limited to flowlines, wellheads, umbilicals, risers, etc.</obo:IAO_0000115>
        <schema:identifier>UA</schema:identifier>
        <rdfs:label>subsea engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000032 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000032">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000032</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing management of contractual development and administration, as well as procurement of finished goods from third parties.</obo:IAO_0000115>
        <schema:identifier>VA</schema:identifier>
        <rdfs:label>contracting and procurement management</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000033 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000033">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000033</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline addressing the collection and analysis of environmental conditions specific to offshore locations, including but not limited to metocean analysis, navigational analysis, ice studies, etc. Excludes structural design and loading.</obo:IAO_0000115>
        <schema:identifier>WA</schema:identifier>
        <rdfs:label>ocean engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000043 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000043">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Discipline"/>
        <hasCFIHOSCode>CFIHOS-20000043</hasCFIHOSCode>
        <obo:IAO_0000115>A discipline covering the management of verification of installation, energization and testing of equipment.  May include but is not limited to multi-discipline procedures, etc.</obo:IAO_0000115>
        <schema:identifier>BC</schema:identifier>
        <rdfs:label>commissioning</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-20000500 -->


