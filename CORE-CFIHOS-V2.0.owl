        <hasCFIHOSCode>CFIHOS-30000632</hasCFIHOSCode>
        <obo:IAO_0000115>Which is flat and typically vertical suitable for separation.</obo:IAO_0000115>
        <rdfs:label>wall</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000633 -->


