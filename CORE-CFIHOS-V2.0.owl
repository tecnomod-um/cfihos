        <hasCFIHOSCode>CFIHOS-60000056</hasCFIHOSCode>
        <obo:IAO_0000115>A low-carbon version of 317 SS with enhanced resistance to intergranular corrosion and stress corrosion cracking. It is suitable for applications in harsh environments3</obo:IAO_0000115>
        <rdfs:label>317L SS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000057 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000057">
