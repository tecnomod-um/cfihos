        <obo:IAO_0000115>A system that provides lubricant to rotating or moving items.</obo:IAO_0000115>
        <rdfs:label>lubrication system</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000542 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000542">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000314"/>
        <hasCFIHOSCode>CFIHOS-30000542</hasCFIHOSCode>
        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A seal that comprises of a set of one or more rotating and stationary seal faces, together with auxiliary hardware, separated by a film of fluid intended to reduce flow loss around a rotating shaft to an acceptable level.</obo:IAO_0000115>
        <rdfs:label>mechanical seal</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000543 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/tag#CFIHOS-30000543">
