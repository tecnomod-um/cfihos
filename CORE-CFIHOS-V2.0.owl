    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000503 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000503">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000181"/>
