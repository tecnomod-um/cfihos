    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000178 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000178">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000178</hasCFIHOSCode>
        <obo:IAO_0000115>Books, as defined in the CFIHOS require this Index to be created. Since the purpose of the &apos;index&apos; is management of a group of documents, this can only be associated with JA &apos;information management&apos;. Examples: &apos;health&apos;, &apos;safety&apos;, &apos;environment&apos;, &apos;quality communication dossier basic design&apos;, &apos;engineering package authority approval package&apos;.</obo:IAO_0000115>
        <schema:identifier>4372</schema:identifier>
        <rdfs:label>index of documents</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000179 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000179">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000179</hasCFIHOSCode>
        <obo:IAO_0000115>An authoritative collection of values with a relationship to a specific equipment.  List to show input and output of an equipment (e.g. instrument, telecom equipment) connected to other equipment (e.g. distributed control system, programmable logic controller).The columns of this collection is specified and controlled.</obo:IAO_0000115>
        <schema:identifier>4327</schema:identifier>
        <rdfs:label>input, output list</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000180 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000180">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000180</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular activities and requirements will be executed and delivered relating to inspection and testing for construction &amp; vendor work.</obo:IAO_0000115>
        <schema:identifier>5733</schema:identifier>
        <rdfs:label>inspection and test plan</rdfs:label>
        <skos:altLabel>itp</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000181 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000181">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000181</hasCFIHOSCode>
        <obo:IAO_0000115>A document that describes methods of installing a piece of equipment.  Installation refers to the mounting, setting, erection, etc.</obo:IAO_0000115>
        <schema:identifier>3328</schema:identifier>
        <rdfs:label>installation manual</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000182 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000182">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000182</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing electrical tracing. Includes anchoring and expansion joint details where applicable. Drawings to indicate thicknesses, specification and limit of application.</obo:IAO_0000115>
        <schema:identifier>2398</schema:identifier>
        <rdfs:label>heat tracing diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000186 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000186">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000186</hasCFIHOSCode>
        <obo:IAO_0000115>A diagrams documenting Interfaces and demarcation of responsibilities between different organizations (e.g. battery limits, terminations).</obo:IAO_0000115>
        <schema:identifier>2341</schema:identifier>
        <rdfs:label>interface diagram</rdfs:label>
        <skos:altLabel>battery limits diagram</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000188 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000188">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000188</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular activities and requirements will be executed and delivered to manage interface between internal and external parties (esp. between contract scopes).</obo:IAO_0000115>
        <schema:identifier>5800</schema:identifier>
        <rdfs:label>interface plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000189 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000189">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000189</hasCFIHOSCode>
        <obo:IAO_0000115>A procedures around Interface management activities between internal and external parties.</obo:IAO_0000115>
        <schema:identifier>6069</schema:identifier>
        <rdfs:label>interface procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000190 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000190">
