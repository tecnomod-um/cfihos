        <hasCFIHOSCode>CFIHOS-60001769</hasCFIHOSCode>
        <obo:IAO_0000115>Atmospheres containing combustible dusts not included in Group E or Group F, including flour, grain, wood, plastic, and chemicals.</obo:IAO_0000115>
        <rdfs:label>G</rdfs:label>
    </owl:NamedIndividual>
    


