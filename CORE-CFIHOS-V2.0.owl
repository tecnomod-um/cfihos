            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000571</hasCFIHOSCode>
        <obo:IAO_0000115>A support that is a large and straight piece of normally timber or iron forming one of the main structural member of a building or supporting structure.</obo:IAO_0000115>
        <rdfs:label>beam</rdfs:label>
    </owl:Class>
    


