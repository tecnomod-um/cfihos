            </owl:Restriction>
        </rdfs:subClassOf>
        <hasCFIHOSCode>CFIHOS-30000637</hasCFIHOSCode>
        <obo:IAO_0000115>A device compensating for axial or radial movement between two elements that is connected.</obo:IAO_0000115>
        <rdfs:label>compensator</rdfs:label>
        <skos:altLabel>heave compensator</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000638 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000638">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000660"/>
        <rdfs:subClassOf>
