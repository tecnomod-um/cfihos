        <obo:IAO_0000115>A relief valve that is used for pressure compensation purposes by admitting (letting in) a pressure to prevent that vacuum is forming when filling or emptying a system.</obo:IAO_0000115>
        <rdfs:label>vacuum relief valve</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000636 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000636">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000660"/>
        <hasCFIHOSCode>CFIHOS-30000636</hasCFIHOSCode>
        <obo:IAO_0000115>A valve that permits fluid to flow in one direction only.</obo:IAO_0000115>
        <rdfs:label>check valve</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000637 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS/equipment#CFIHOS-30000637">
