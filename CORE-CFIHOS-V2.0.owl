        <hasCFIHOSCode>CFIHOS-70000247</hasCFIHOSCode>
        <obo:IAO_0000115>A collection of values with a relationship to a specific topic or object that could be either technical or business related.</obo:IAO_0000115>
        <schema:identifier>4380</schema:identifier>
        <rdfs:label>general list</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000248 -->


