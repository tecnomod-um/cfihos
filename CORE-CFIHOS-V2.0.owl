        <hasCFIHOSCode>CFIHOS-70000251</hasCFIHOSCode>
        <obo:IAO_0000115>Multimedia being &apos;picture&apos;, &apos;sound&apos; or &apos;video&apos;.  Includes laser scans, x-rays, sonograms, installation videos, photogrammetry, illustrations, &apos;fly-throughs&apos;, etc.</obo:IAO_0000115>
        <schema:identifier>5280</schema:identifier>
        <rdfs:label>multimedia</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000253 -->


