        <hasCFIHOSCode>CFIHOS-70000066</hasCFIHOSCode>
        <obo:IAO_0000115>A pictorial representation of the main elements and functions of a control circuit/system with input/output sources (switches, relays etc.) and their relationships. Details logic functions of the circuit/system. I/O loading and cabinet layouts.</obo:IAO_0000115>
        <schema:identifier>2312</schema:identifier>
        <rdfs:label>control system diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000070 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000070">
