        <hasCFIHOSCode>CFIHOS-70000367</hasCFIHOSCode>
        <obo:IAO_0000115>A document defining of work to be performed as part of a contract.</obo:IAO_0000115>
        <schema:identifier>5793</schema:identifier>
        <rdfs:label>scope of work</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000368 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000368">
