        <hasCFIHOSCode>CFIHOS-70000358</hasCFIHOSCode>
        <obo:IAO_0000115>A document certifying the correct gross weight for a piece of equipment including packing materials.  This typically should also document the center of gravity.</obo:IAO_0000115>
        <schema:identifier>1447</schema:identifier>
        <rdfs:label>weight certificate</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000359 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000359">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000359</hasCFIHOSCode>
        <obo:IAO_0000115>A report shows weight and center of gravity of equipment. If large items are to be handled for equipment installation or maintenance, then the weight and center of gravity of these individual parts should be shown.</obo:IAO_0000115>
        <schema:identifier>1448</schema:identifier>
        <rdfs:label>weight report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000360 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000360">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000360</hasCFIHOSCode>
