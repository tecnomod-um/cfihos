        <hasCFIHOSCode>CFIHOS-70000245</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting status and observations relating to an asset/object. Can include paint, insulation, noise, thickness measurement, destructive weld testing, NDE, preservation, cathodic protection tests, etc. Excludes pressure tests.</obo:IAO_0000115>
        <schema:identifier>3880</schema:identifier>
        <rdfs:label>inspection report</rdfs:label>
        <skos:altLabel>test report</skos:altLabel>
    </owl:Class>
    


