        <obo:IAO_0000115>Polymer of Acrylic Acid</obo:IAO_0000115>
        <rdfs:label>acrylic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000104 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000104">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000013"/>
        <hasCFIHOSCode>CFIHOS-60000104</hasCFIHOSCode>
        <obo:IAO_0000115>An chemical substance that resembles natural latex.</obo:IAO_0000115>
        <rdfs:label>acrylic latex</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000105 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000105">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000110"/>
        <hasCFIHOSCode>CFIHOS-60000105</hasCFIHOSCode>
