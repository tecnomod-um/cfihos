        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000175</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting  assumptions and method determining computer structural analysis for topsides modules including piperack, flare tower, bridge for in-place loading condition.</obo:IAO_0000115>
        <schema:identifier>0514</schema:identifier>
