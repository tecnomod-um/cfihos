    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000086 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000086">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000086</hasCFIHOSCode>
        <obo:IAO_0000115>A super austenitic stainless steel with high corrosion resistance and low carbon content. It is used for chemical processing, seawater desalination, and oil and gas production1.</obo:IAO_0000115>
        <rdfs:label>904L</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000087 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000087">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000087</hasCFIHOSCode>
        <obo:IAO_0000115>A fabric conditioner that leaves laundry super soft and smelling beautiful. It is available in a variety of fragrances2.</obo:IAO_0000115>
        <rdfs:label>925L</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000088 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000088">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000088</hasCFIHOSCode>
        <obo:IAO_0000115>A ferritic-martensitic steel with chromium, molybdenum, and vanadium as alloying elements. It has good creep strength, oxidation resistance, and hydrogen embrittlement resistance. It is used for power generation, petrochemical, and nuclear applications3.</obo:IAO_0000115>
        <rdfs:label>9CR-1MO-V</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000089 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000089">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000089</hasCFIHOSCode>
        <obo:IAO_0000115>A low-carbon nickel steel with 9% nickel content. It has high toughness and ductility at cryogenic temperatures. It is used for liquefied natural gas (LNG) storage tanks and pressure vessels4.</obo:IAO_0000115>
        <rdfs:label>9Ni</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000090 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000090">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000034"/>
        <hasCFIHOSCode>CFIHOS-60000090</hasCFIHOSCode>
        <obo:IAO_0000115>Class-A insulation describes the insulation capacity of the machine winding to handle heat up to 105 DegC.</obo:IAO_0000115>
        <rdfs:label>A (105 DegC)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000091 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000091">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000091</hasCFIHOSCode>
        <obo:IAO_0000115>A dense, strong, general-purpose castable refractory for temperatures up to 2550°F. It has good thermal shock resistance and abrasion resistance. It is used for boilers, furnaces, kilns, and incinerators5.</obo:IAO_0000115>
        <rdfs:label>A.P. GREEN KS4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000092 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000092">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000092</hasCFIHOSCode>
        <obo:IAO_0000115>A low alloy chromium-ferritic steel fastener for high tensile, high temperature, and special purpose applications. It has good corrosion resistance and can be quenched and tempered at 1100°F minimum. It is used for pressure piping and pressure vessels bolting6.</obo:IAO_0000115>
        <rdfs:label>A193-B5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000093 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000093">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000093</hasCFIHOSCode>
        <obo:IAO_0000115>A martensitic stainless steel fastener with 12% chromium content. It has high strength and hardness after heat treatment. It is used for high temperature service applications such as boilers, flanges, valves, and fittings7.</obo:IAO_0000115>
        <rdfs:label>A193-B6</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000094 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000094">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000094</hasCFIHOSCode>
        <obo:IAO_0000115>A modified version of A193-B6 with lower carbon content and higher chromium content. It has improved corrosion resistance and weldability compared to A193-B6. It is used for similar applications as A193-B68.</obo:IAO_0000115>
        <rdfs:label>A193-B6X</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000095 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000095">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000095</hasCFIHOSCode>
        <obo:IAO_0000115>A corrosion resistant austenitic stainless steel fastener with 18-8 chromium-nickel alloy composition. It can be carbide solution treated or carbide solution treated and strain hardened depending on the tensile class. It is used for high tensile, high temperature, and special purpose applications such as pressure piping and pressure vessels bolting9.</obo:IAO_0000115>
        <rdfs:label>A193-B8</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000096 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000096">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000096</hasCFIHOSCode>
        <obo:IAO_0000115>A corrosion resistant grade 347 stainless steel fastener with columbium and tantalum as stabilizing elements. It can be carbide solution treated or carbide solution treated and strain hardened depending on the tensile class. It has better intergranular corrosion resistance than A193-B8. It is used for similar applications as A193-B810.</obo:IAO_0000115>
        <rdfs:label>A193-B8C</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000097 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000097">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000097</hasCFIHOSCode>
        <obo:IAO_0000115>A corrosion resistant grade 316/316L stainless steel fastener with molybdenum as an alloying element. It can be carbide solution treated or carbide solution treated and strain hardened depending on the tensile class. It has better pitting and crevice corrosion resistance than A193-B8. It is used for similar applications as A193-B811.</obo:IAO_0000115>
        <rdfs:label>A193-B8M</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000098 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000098">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000098</hasCFIHOSCode>
        <obo:IAO_0000115>A corrosion resistant grade 321 stainless steel fastener with titanium as a stabilizing element. It can be carbide solution treated or carbide solution treated and strain hardened depending on the tensile class. It has better intergranular corrosion resistance than A193-B8. It is used for similar applications as A193-B812.</obo:IAO_0000115>
        <rdfs:label>A193-B8T</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000099 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000099">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000073"/>
        <hasCFIHOSCode>CFIHOS-60000099</hasCFIHOSCode>
        <obo:IAO_0000115>A stainless steel bolting material for low temperature service applications such as pressure vessels, valves, flanges, and fittings. It is heat treated AISI 304 stainless steel with supplementary notch toughness properties13.</obo:IAO_0000115>
        <rdfs:label>A320-B8</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000100 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000100">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000013"/>
        <hasCFIHOSCode>CFIHOS-60000100</hasCFIHOSCode>
        <obo:IAO_0000115>ABS (Acrylonitrile butadiene styrene) is a common thermoplastic polymer coating.</obo:IAO_0000115>
        <rdfs:label>ABS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000101 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000101">
        <rdf:type rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-50000108"/>
        <hasCFIHOSCode>CFIHOS-60000101</hasCFIHOSCode>
        <obo:IAO_0000115>Alternating current is an electric current which periodically reverses direction and changes its magnitude continuously with time</obo:IAO_0000115>
        <rdfs:label>AC</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000102 -->


    <owl:NamedIndividual rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-60000102">
