        <hasCFIHOSCode>CFIHOS-30000501</hasCFIHOSCode>
        <obo:IAO_0000115>A bellows that is a flexible corrugated tubular element providing axial and radial flexibility and pressure containment.</obo:IAO_0000115>
        <rdfs:label>piping expansion bellows</rdfs:label>
    </owl:Class>
    


