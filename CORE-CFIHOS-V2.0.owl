        <schema:identifier>3311</schema:identifier>
        <rdfs:label>change notification</rdfs:label>
        <skos:altLabel>advanced change notice (acn)</skos:altLabel>
        <skos:altLabel>design change notice (dcn)</skos:altLabel>
        <skos:altLabel>technical design notice (tdn)</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000045 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000045">
