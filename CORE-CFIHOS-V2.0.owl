        <hasSourceStandard rdf:resource="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-90000177"/>
        <obo:IAO_0000115>A fluid coupling intended to allow a smooth start of a driven equipment and then keeping a nearly constant speed.</obo:IAO_0000115>
        <rdfs:label>torque converter</rdfs:label>
    </owl:Class>
    


