        <hasCFIHOSCode>CFIHOS-70000276</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing all dimensions, length width or diameter depending on square vs round.  Shows welding detail if splices for steel piles.  Show where all reinforcing steel (rebar) or pretensioned cable configuration and tension for concrete.</obo:IAO_0000115>
        <schema:identifier>2401</schema:identifier>
        <rdfs:label>pile details</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000277 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000277">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000277</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing the precise location of assets/objects at a plant, process unit, or area basis relative to surrounding structures and equipment.</obo:IAO_0000115>
        <schema:identifier>4033</schema:identifier>
        <rdfs:label>layout diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000278 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000278">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000278</hasCFIHOSCode>
        <obo:IAO_0000115>An authoritative collection of values with a relationship to piping. The columns of this collection are specified and controlled.</obo:IAO_0000115>
        <schema:identifier>4338</schema:identifier>
        <rdfs:label>piping line list</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000280 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000280">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000280</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular activities and requirements will be executed and delivered to manage subcontracts.  Also used to track status of all the essential activities to be performed. It categorises the actions to be taken (e.g. team roles and responsibilities) and also the status of them (e.g. &apos;open&apos;, &apos;action party&apos;, &apos;due date&apos;).</obo:IAO_0000115>
        <schema:identifier>5879</schema:identifier>
        <rdfs:label>subcontract management plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000283 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000283">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000283</hasCFIHOSCode>
        <obo:IAO_0000115>A report summarizing technical or commercial evaluation of a pre-qualification to tender.</obo:IAO_0000115>
        <schema:identifier>7003</schema:identifier>
        <rdfs:label>pre-qualification evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000284 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000284">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000284</hasCFIHOSCode>
        <obo:IAO_0000115>A request for information from a third party who may provide services or supply materials in order to identify if they meet required criteria.</obo:IAO_0000115>
        <schema:identifier>3356</schema:identifier>
        <rdfs:label>pre-qualification questionnaire</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000286 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000286">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000286</hasCFIHOSCode>
        <obo:IAO_0000115>A procedure documenting specific steps to conduct inspection of an asset/object.  Typically details boundaries of the test, isolations, method of pressurization, required hold intervals etc.  Includes hydrostatic, pneumatic, vacuum and leak test/examinations.</obo:IAO_0000115>
        <schema:identifier>6046</schema:identifier>
        <rdfs:label>pressure test procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000287 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000287">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000287</hasCFIHOSCode>
        <obo:IAO_0000115>A report recording duration and results of hydro static, pneumatic, and leak test examinations.  Typically includes a pressure chart to demonstrate satisfactory results.</obo:IAO_0000115>
        <schema:identifier>8611</schema:identifier>
        <rdfs:label>pressure test report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000289 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000289">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000289</hasCFIHOSCode>
        <obo:IAO_0000115>A document describing the process control functionality (e.g. level control).</obo:IAO_0000115>
        <schema:identifier>5306</schema:identifier>
        <rdfs:label>process control narrative</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000290 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000290">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000290</hasCFIHOSCode>
        <obo:IAO_0000115>A document detailing evaluation of operating scenarios and control schemas in order to optimize the facility design and control.</obo:IAO_0000115>
        <schema:identifier>8248</schema:identifier>
        <rdfs:label>process control, optimisation study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000292 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000292">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000292</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing equipment, piping, and instrumentation representing topology and process flow. Includes Utility Engineering Flow Schemes (UEFS) and Fire Fighting Flow Schemes.</obo:IAO_0000115>
        <schema:identifier>2365</schema:identifier>
        <rdfs:label>piping and instrumentation diagram</rdfs:label>
        <skos:altLabel>process engineering flow scheme (PEFS)</skos:altLabel>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000293 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000293">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000293</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing major items of equipment, primary lines and valves, operating temperatures, pressures and mass flows. Diagrams shall be provided for all hydrocarbon and utilities systems. Includes &apos;utility flow schemes/diagrams&apos; [UFS/UFD].</obo:IAO_0000115>
        <schema:identifier>2366</schema:identifier>
        <rdfs:label>process flow diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000295 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000295">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000295</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram detailing safeguarding elements for process and utility protection against uncontrolled loss of containment.</obo:IAO_0000115>
        <schema:identifier>2368</schema:identifier>
        <rdfs:label>process safeguarding flow diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000298 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000298">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000298</hasCFIHOSCode>
        <obo:IAO_0000115>A time-based document outlining sequence and duration of activities related to procurement activities (RFQs, purchase orders, required on site milestones, etc.).</obo:IAO_0000115>
        <schema:identifier>5805</schema:identifier>
        <rdfs:label>procurement schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000299 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000299">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000299</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining purpose and approach for developing contracting and procurement strategies is to identify the in-house scope and the contract packages that will eventually be placed in the market.  The development of contracting &amp; procurement strategies is the first step towards aligning the project demands of external parties (in terms of the required goods and services), with the market supply, in terms of capable and experienced contractors and suppliers.</obo:IAO_0000115>
        <schema:identifier>5756</schema:identifier>
        <rdfs:label>procurement, contracting strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000300 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000300">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000300</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting progress made against a previously communicated plan or schedule. &apos;progress reports&apos; can address time, scope, money, etc.</obo:IAO_0000115>
        <schema:identifier>6944</schema:identifier>
        <rdfs:label>progress report</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000302 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000302">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000302</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing key project control execution plans applicable across the project scope.</obo:IAO_0000115>
        <schema:identifier>5759</schema:identifier>
        <rdfs:label>project control plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000303 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000303">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000303</hasCFIHOSCode>
        <obo:IAO_0000115>A list of content types to be delivered by the project.</obo:IAO_0000115>
        <schema:identifier>5762</schema:identifier>
        <rdfs:label>project lifecycle information register</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000305 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000305">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000305</hasCFIHOSCode>
        <obo:IAO_0000115>A time-based document summarizing all discipline related activities outlining sequence and duration.</obo:IAO_0000115>
        <schema:identifier>5765</schema:identifier>
        <rdfs:label>project schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000309 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000309">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000309</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing what particular activities and requirements will be executed and delivered to support recruitment.  Typically the plan is built upon a strategy.</obo:IAO_0000115>
        <schema:identifier>5795</schema:identifier>
        <rdfs:label>recruitment plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000310 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000310">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000310</hasCFIHOSCode>
        <obo:IAO_0000115>Includes steel reinforcement in concrete structures (e.g., rebar).</obo:IAO_0000115>
        <schema:identifier>2397</schema:identifier>
        <rdfs:label>reinforcement diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000312 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000312">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000312</hasCFIHOSCode>
        <obo:IAO_0000115>Demonstrates starting and operating reliability / availability of purchased equipment  (e.g. mean time between failure data) &amp; &apos;safety integrity level&apos; (SIL) calculations.</obo:IAO_0000115>
        <schema:identifier>1222</schema:identifier>
        <rdfs:label>reliability, availability, safety integrity level calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000313 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000313">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000313</hasCFIHOSCode>
        <obo:IAO_0000115>Process relief valve calculation. the output is documented in the process safeguarding memorandum.</obo:IAO_0000115>
        <schema:identifier>2908</schema:identifier>
        <rdfs:label>relief valve calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000315 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000315">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000315</hasCFIHOSCode>
        <obo:IAO_0000115>A study related to the impact on personnel or equipment of lit or unlit relief, flaring and venting events.</obo:IAO_0000115>
        <schema:identifier>8249</schema:identifier>
        <rdfs:label>relief, flare and vent study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000317 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000317">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000317</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing how risks and opportunities will be documented, communicated, managed, and closed.  Typically the plan is built upon a strategy.</obo:IAO_0000115>
        <schema:identifier>5768</schema:identifier>
        <rdfs:label>risk and opportunity management plan</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000318 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000318">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000318</hasCFIHOSCode>
        <obo:IAO_0000115>An assessment which details the quantitative or qualitative risk related to a specific scenario presented to &apos;company&apos;.</obo:IAO_0000115>
        <schema:identifier>0709</schema:identifier>
        <rdfs:label>risk assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000319 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000319">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000319</hasCFIHOSCode>
        <obo:IAO_0000115>An authoritative collection of items with a relationship to risks and/or opportunities which have a potential to impact overall project performance.  The columns of this collection are specified and controlled.</obo:IAO_0000115>
        <schema:identifier>6619</schema:identifier>
        <rdfs:label>risk, opportunity register</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000320 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000320">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000320</hasCFIHOSCode>
        <obo:IAO_0000115>A study describing priorities and criteria, practical restrictions, and options considered for route selection.  Includes route layout drawing and/or platform approach where applicable.</obo:IAO_0000115>
        <schema:identifier>6958</schema:identifier>
        <rdfs:label>route selection study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000321 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000321">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000321</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing alignment of cables and pipelines between plants. Includes alignment sheet for pipelines.</obo:IAO_0000115>
        <schema:identifier>2373</schema:identifier>
        <rdfs:label>routing diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000322 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000322">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000322</hasCFIHOSCode>
        <obo:IAO_0000115>A study validating electrical systems design will allow for safe operation.</obo:IAO_0000115>
        <schema:identifier>8251</schema:identifier>
        <rdfs:label>safe operation study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000323 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000323">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000323</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for decisions that are to be followed regarding process relief cases, the ultimate safeguards (relief devices) and penultimate safeguards (safeguards by instrumentation) for process integrity of a particular process unit. It complements the &apos;process safeguarding flow diagram&apos;.</obo:IAO_0000115>
        <schema:identifier>3363</schema:identifier>
        <rdfs:label>safeguarding memorandum</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000324 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000324">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000324</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for decisions that are to be followed regarding safety instrumented systems (SIS) and flare and relief systems for process integrity of a facility.  Protecting against temperature and pressure extremes, hydrates, fire, explosion, etc.</obo:IAO_0000115>
        <schema:identifier>5531</schema:identifier>
        <rdfs:label>safeguarding philosophy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000325 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000325">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000325</hasCFIHOSCode>
        <obo:IAO_0000115>A certificate issued by asset owner to &apos;regulatory authority&apos; demonstrating compliance with &apos;regulatory authority&apos; safety  requirements. A &apos;safety declaration&apos; is a document that describes the nature and scale of hazards of an industrial facility, lays out measures developed to ensure its industrial safety and readiness for emergency response in  man-induced emergency situations.</obo:IAO_0000115>
        <schema:identifier>1439</schema:identifier>
        <rdfs:label>safety declaration</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000327 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000327">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000327</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing the main safety features of the facility. Typically related to toxic zones. e.g. &apos;H2S zone&apos; diagram.</obo:IAO_0000115>
        <schema:identifier>2374</schema:identifier>
        <rdfs:label>safety zone diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000328 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000328">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000328</hasCFIHOSCode>
        <obo:IAO_0000115>A pictorial representation of the main elements and functions of a control circuit for electrical equipment with input/output sources (switches, relays etc.) and their relationships. Details logic functions of the circuit.</obo:IAO_0000115>
        <schema:identifier>2580</schema:identifier>
        <rdfs:label>schematic diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000330 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000330">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000330</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram for equipment, panels, junction boxes, etc. identifies all connections and cable terminations at input/output rails. Required for removal/hook up purposes and modifications. To include vendor interfaces.</obo:IAO_0000115>
        <schema:identifier>2389</schema:identifier>
        <rdfs:label>termination diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000331 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000331">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000331</hasCFIHOSCode>
        <obo:IAO_0000115>A document capturing scope and details of the activity to which it refers and any conditions relating to the appointment of a person(s) to undertake the activity. Includes the distribution of work, schedule and the responsibilities among the people participating in an evaluation process.</obo:IAO_0000115>
        <schema:identifier>7753</schema:identifier>
        <rdfs:label>terms of reference</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000332 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000332">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000332</hasCFIHOSCode>
        <obo:IAO_0000115>A procedure to perform a test that equipment or systems are functioning and performing according to the specifications, function descriptions and operating instructions.</obo:IAO_0000115>
        <schema:identifier>6061</schema:identifier>
        <rdfs:label>test procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000333 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000333">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000333</hasCFIHOSCode>
        <obo:IAO_0000115>A time-based document outlining order in which tasks are to be carried out and the amounts of time allocated to them to achieve inspection and testing scope.</obo:IAO_0000115>
        <schema:identifier>5780</schema:identifier>
        <rdfs:label>testing, inspection schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000334 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000334">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000334</hasCFIHOSCode>
        <obo:IAO_0000115>A document detailing the result from thermal expansion and informing design regarding the need for loops and expansion joints.</obo:IAO_0000115>
        <schema:identifier>8263</schema:identifier>
        <rdfs:label>thermal expansion study</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000335 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000335">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000335</hasCFIHOSCode>
        <obo:IAO_0000115>Calculations to demonstrate thermal ratings of heat exchangers.</obo:IAO_0000115>
        <schema:identifier>1208</schema:identifier>
        <rdfs:label>thermal rating calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000337 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000337">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000337</hasCFIHOSCode>
        <obo:IAO_0000115>Tie-in list identifies areas of a brownfield facility where connections will be made. May include interfaces between project stages, contractors and systems (e.g. new to existing plant connections).</obo:IAO_0000115>
        <schema:identifier>4363</schema:identifier>
        <rdfs:label>tie-in list</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000338 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000338">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000338</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram describing grade and elevation of a given area.  Also for seafloor at offshore site and access route.</obo:IAO_0000115>
        <schema:identifier>4904</schema:identifier>
        <rdfs:label>topographic map</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000339 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000339">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000339</hasCFIHOSCode>
        <obo:IAO_0000115>A collection of training materials.  May include &apos;operational &amp; maintenance training plan&apos; providing durations and locations of sessions.</obo:IAO_0000115>
        <schema:identifier>1927</schema:identifier>
        <rdfs:label>training manual</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000340 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000340">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000340</hasCFIHOSCode>
        <obo:IAO_0000115>A report documenting  assumptions and method determining computer analysis to verify the module design for transportation condition.</obo:IAO_0000115>
        <schema:identifier>0521</schema:identifier>
        <rdfs:label>transportation analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000342 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000342">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000342</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram depicting civil earthworks for utility services (e.g., piping, cables) for construction activity management.  Typically depicts slope, etc.</obo:IAO_0000115>
        <schema:identifier>4006</schema:identifier>
        <rdfs:label>trench diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000343 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000343">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/CFIHOS#Document"/>
        <hasCFIHOSCode>CFIHOS-70000343</hasCFIHOSCode>
        <obo:IAO_0000115>A diagram showing the precise location of assets/objects at a plant, process unit, or area basis, describing elevation and relative to surrounding structures and equipment.</obo:IAO_0000115>
        <schema:identifier>4038</schema:identifier>
        <rdfs:label>underground service layout diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000346 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000346">
