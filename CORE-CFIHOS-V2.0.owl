        <hasCFIHOSCode>CFIHOS-70000253</hasCFIHOSCode>
        <obo:IAO_0000115>A document outlining the premise and intent for decisions that are to be followed regarding a specific subject. Typically provided as instruction from &apos;owner operator&apos;.</obo:IAO_0000115>
        <schema:identifier>5680</schema:identifier>
        <rdfs:label>general philosophy</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000255 -->


    <owl:Class rdf:about="http://infohub.siemens-energy.com/CFIHOS#CFIHOS-70000255">
